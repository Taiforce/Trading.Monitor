WEB_PORT=5088
SQLSERVER_PORT=14333
SQLSERVER_SA_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
# Dedicated, least-privilege SQL login used by the web/worker containers instead of `sa`.
# Created automatically by the one-shot `sql-init` service on first `docker compose up`.
SQLSERVER_APP_USER=trading_app
SQLSERVER_APP_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_PASSWORD
APP_TIME_ZONE=America/Mexico_City
# AdminAccess is required by default (no anonymous fallback). Set a unique password of at
# least 12 characters that is NOT one of the well-known examples in this file.
ADMIN_ACCESS_ENABLED=true
ADMIN_ACCESS_USERNAME=admin
ADMIN_ACCESS_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD_12_CHARS_MIN
# Only set to true for a throwaway local stack with zero exposure. When true, every page and
# API endpoint is served without authentication.
ADMIN_ACCESS_ALLOW_ANONYMOUS=false

TRADING_MONITOR_ENABLED=true
TRADING_MINIMUM_SCORE=88
TRADING_EVALUATION_INTERVAL_SECONDS=60
RISK_TARGET_1R=2.2
RISK_TARGET_2R=3.4
RISK_MINIMUM_RISK_REWARD=2.2
RISK_FEE_PERCENT_PER_SIDE=0.1
RISK_SPREAD_PERCENT=0.05
RISK_MIN_NET_PROFIT_AFTER_COSTS=0.35
RISK_MANAGED_PROFIT_EXIT_ENABLED=true
RISK_MANAGED_PROFIT_EXIT_PERCENT_AFTER_COSTS=5
RISK_MANAGED_QUICK_PROFIT_EXIT_PERCENT_AFTER_COSTS=8
RISK_MANAGED_TRAILING_GIVEBACK_PERCENT=0.75
RISK_MANAGED_EXIT_REQUIRES_MOMENTUM_WEAKNESS=true
RISK_MANAGED_HARD_STOP_EXIT_ENABLED=false
RISK_MANAGED_EXPIRY_EXIT_ENABLED=false

MARKET_BINANCE_ENABLED=true
MARKET_BINANCE_US_ENABLED=true
MARKET_COINBASE_ENABLED=true
MARKET_KRAKEN_ENABLED=true
MARKET_YAHOO_FOREX_ENABLED=true
MARKET_ALPHA_VANTAGE_FOREX_ENABLED=true
BINANCE_BASE_URL=https://api.binance.com
BINANCE_US_BASE_URL=https://api.binance.us
COINBASE_BASE_URL=https://api.exchange.coinbase.com
KRAKEN_BASE_URL=https://api.kraken.com
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=
MARKET_TIMEOUT_SECONDS=10
NEWS_ENABLED=true
NEWS_FEAR_GREED_ENABLED=true
NEWS_CRYPTOPANIC_ENABLED=true
CRYPTOPANIC_AUTH_TOKEN=

OPENAI_ENABLED=true
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_TEXT_VERBOSITY=low
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_NEWS_ITEMS=12
OPENAI_MIN_NEWS_ITEMS_TO_ANALYZE=3
OPENAI_MIN_MINUTES_BETWEEN_CALLS=15
OPENAI_MAX_PROMPT_CHARACTERS=6000
OPENAI_ONLY_ANALYZE_WHEN_NEWS_CHANGED=true
OPENAI_API_KEY=

REPORTING_DEFAULT_CAPITAL=1000
REPORTING_FEE_PERCENT_PER_SIDE=0.1
REPORTING_MIN_NET_PROFIT_AFTER_COSTS=0.35

EXCHANGE_EXECUTION_ENABLED=true
EXCHANGE_EXECUTION_PROVIDER=BinanceSpot
EXCHANGE_EXECUTION_MODE=Paper
EXCHANGE_EXECUTION_BASE_URL=https://api.binance.com
EXCHANGE_ALLOW_LIVE_ORDERS=false
EXCHANGE_USE_TEST_ORDER_ENDPOINT=true
EXCHANGE_MAX_CAPITAL_PER_TRADE=100
EXCHANGE_DAILY_LOSS_LIMIT=50
EXCHANGE_MIN_SCORE_TO_EXECUTE=95
EXCHANGE_MIN_EXPECTED_NET_PROFIT_AFTER_COSTS=0.6
EXCHANGE_ENABLE_ENTRY_ORDERS=true
EXCHANGE_ENABLE_EXIT_ORDERS=true
EXCHANGE_ALLOW_SHORT_SELLING=false
EXCHANGE_RECV_WINDOW_MS=5000
EXCHANGE_MAX_SLIPPAGE_PERCENT=0.25
EXCHANGE_ALLOWED_SYMBOL_0=BTCUSDT
EXCHANGE_ALLOWED_SYMBOL_1=ETHUSDT
# AllowedSymbols now fails closed: leaving it empty blocks every symbol instead of allowing all.
EXCHANGE_ALLOW_ALL_SYMBOLS=false
EXCHANGE_KILL_SWITCH_ENABLED=false
EXCHANGE_MAX_OPEN_POSITIONS=3
EXCHANGE_MAX_DAILY_NOTIONAL=500
# Extra explicit confirmation required (in addition to EXCHANGE_ALLOW_LIVE_ORDERS=true and
# EXCHANGE_USE_TEST_ORDER_ENDPOINT=false) before any real order is ever placed.
TRADING_MONITOR_LIVE_CONFIRM=
BINANCE_API_KEY=
BINANCE_API_SECRET=

NOTIFICATIONS_CONSOLE_ENABLED=true

EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- AI signal sources (Propias / Ajenas / Traders) ---
# "Propias" (own self-learning) is always on - it's core Worker behavior, not a toggle.
# "Ajenas" (external ensemble of public strategies) and "Traders" (real leaderboard positions)
# can each be turned off independently.
EXTERNAL_AI_ENABLED=true
TRADER_SIGNALS_ENABLED=true
TRADER_SIGNALS_BINANCE_LEADERBOARD_ENABLED=true
