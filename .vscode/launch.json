{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Trading.Monitor.Web/bin/Debug/net10.0/Trading.Monitor.Web.dll",
      "cwd": "${workspaceFolder}/src/Trading.Monitor.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5088"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": ".NET: Worker",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Trading.Monitor.Worker/bin/Debug/net10.0/Trading.Monitor.Worker.dll",
      "cwd": "${workspaceFolder}/src/Trading.Monitor.Worker",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  ]
}
