@page "/posiciones"
@model ManagedPositionsModel
@{
    ViewData["Title"] = "Posiciones vivas";
}

<section class="dashboard">
    <div class="page-head">
        <div>
            <p class="eyebrow">Entrada viva, salida por análisis</p>
            <h1>Seguimiento por señal</h1>
        </div>
        <form method="get" class="filter-bar managed-filter">
            <label>
                <span>Monto</span>
                <input asp-for="Capital" type="number" min="0.01" step="0.01"/>
            </label>
            <label>
                <span>Ganancia neta %</span>
                <input asp-for="TargetNetPercent" type="number" min="-99" max="1000" step="0.01"/>
            </label>
            <label>
                <span>Estado</span>
                <select asp-for="Estado">
                    <option value="abiertas">Abiertas</option>
                    <option value="cerradas">Cerradas</option>
                    <option value="todas">Todas</option>
                </select>
            </label>
            <label>
                <span>Tipo</span>
                <select asp-for="TipoSenal">
                    <option value="">Todas</option>
                    <option value="@Model.BuyLowSellHighValue">Compra bajo - vende alto</option>
                    <option value="@Model.SellHighBuyLowValue">Vende alto - compra bajo</option>
                </select>
            </label>
            <label>
                <span>Activo</span>
                <select asp-for="Symbol">
                    <option value="">Todos</option>
                    @foreach (var symbol in Model.Symbols)
                    {
                        <option value="@symbol">@symbol</option>
                    }
                </select>
            </label>
            <button type="submit">Aplicar</button>
        </form>
    </div>

    <section class="metrics-grid metrics-grid-four" aria-label="Resumen de posiciones vivas">
        <article class="metric">
            <span>Vivas</span>
            <strong>@Model.Rows.Count(row => row.Status == Trading.Monitor.Domain.OpportunityStatus.Open)</strong>
            <small>monitoreadas hasta salida</small>
        </article>
        <article class="metric">
            <span>Objetivo neto</span>
            <strong class="gain">@Model.TargetNetPercent.ToString("N2")%</strong>
            <small>después de comisiones</small>
        </article>
        <article class="metric">
            <span>Cerradas</span>
            <strong>@Model.Rows.Count(row => row.Status != Trading.Monitor.Domain.OpportunityStatus.Open)</strong>
            <small>con resultado medido</small>
        </article>
        <article class="metric">
            <span>Capital por señal</span>
            <strong>@Model.Money(Model.Report.Capital)</strong>
            <small>simulación actual</small>
        </article>
    </section>

    <div class="insight-strip trade-type-guide">
        <span>Sin salida fija</span>
        <strong>La señal indica entrada. Después el sistema monitorea el mercado y puedes ajustar el porcentaje neto por señal para decidir si cierras al precio actual.</strong>
    </div>

    <section class="report-section live-board" data-live-mode="managed" data-live-capital="@Model.Report.Capital" data-live-estado="@Model.Estado" data-live-symbol="@Model.Symbol" data-live-tipo-senal="@Model.TipoSenal" data-live-target-net-percent="@Model.TargetNetPercent" data-live-fee-percent="@Model.EstimatedFeePercentPerSide">
        <div class="section-title">
            <h2>Seguimiento en vivo</h2>
            <span id="liveUpdated">actualizando...</span>
        </div>
        <div class="chart-toolbar" aria-label="Controles del gráfico">
            <div>
                <span>Activo</span>
                @foreach (var symbol in Model.Symbols)
                {
                    <button type="button" data-chart-symbol-button="@symbol">@Model.SymbolButtonLabel(symbol)</button>
                }
            </div>
            <div>
                <span>Tiempo</span>
                <button type="button" data-chart-interval="1s">1s</button>
                <button type="button" data-chart-interval="1m" class="active">1m</button>
                <button type="button" data-chart-interval="15m">15m</button>
                <button type="button" data-chart-interval="1h">1h</button>
                <button type="button" data-chart-interval="1d">1d</button>
                <button type="button" data-chart-interval="1w">1w</button>
                <button type="button" data-chart-interval="1M">1M</button>
            </div>
            <div class="chart-zoom-control">
                <span>Zoom</span>
                <button type="button" data-chart-zoom-out>-</button>
                <input id="chartZoom" type="range" min="0" max="100" value="45" aria-label="Zoom del gráfico"/>
                <button type="button" data-chart-zoom-in>+</button>
                <strong id="chartZoomLabel">medio</strong>
            </div>
            <div>
                <button type="button" data-chart-live>Vivo</button>
            </div>
        </div>
        <div id="chartAnalysis" class="chart-analysis">
            <strong>Calculando lectura...</strong>
            <span>El tablero se actualiza solo.</span>
        </div>
        <div class="live-layout">
            <div class="trade-terminal">
                <div class="terminal-strip" id="terminalStrip">
                    <strong>BTCUSDT</strong>
                    <span>cargando mercado...</span>
                </div>
                <div id="advancedTradesChart" class="tradingview-chart" aria-label="Gráfico de seguimiento por señal"></div>
                <div id="chartHoverInfo" class="chart-hover-card" hidden></div>
            </div>
            <div id="liveTradeCards" class="live-trade-list">
                <div class="empty-state">
                    <strong>Cargando seguimientos...</strong>
                    <span>El tablero se refresca solo.</span>
                </div>
            </div>
        </div>
    </section>
</section>

@section Scripts {
    <script src="~/lib/lightweight-charts/lightweight-charts.standalone.production.js"></script>
    <script src="~/js/trading-chart.js" asp-append-version="true"></script>
}
