@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var appTimeZone = Configuration["TradingMonitor:DisplayTimeZone"];
    if (string.IsNullOrWhiteSpace(appTimeZone))
        appTimeZone = Configuration["APP_TIME_ZONE"] ?? Configuration["TZ"] ?? "America/Mexico_City";

    if (string.Equals(appTimeZone, "UTC", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(appTimeZone, "Etc/UTC", StringComparison.OrdinalIgnoreCase))
        appTimeZone = "America/Mexico_City";
}
<!DOCTYPE html>
<html lang="es" data-app-timezone="@appTimeZone">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Trading Monitor</title>
    <script type="importmap"></script>
    <script>
        (() => {
            const stored = localStorage.getItem("trading-monitor-theme");
            const prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.dataset.theme = stored || (prefersDark ? "dark" : "light");
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Trading.Monitor.Web.styles.css" asp-append-version="true"/>
</head>
<body>
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "/Index";
    var currentMarket = Context.Request.Query["Mercado"].ToString();
    string Active(string page) => string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    bool IsPage(params string[] pages) => pages.Any(page => string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase));
    string ActiveGroup(params string[] pages) => IsPage(pages) ? "active" : "";
}
<header class="topbar">
    <nav class="container-fluid app-nav">
        <a class="brand" asp-area="" asp-page="/Index">
            <span class="brand-mark">TM</span>
            <span>Trading Monitor</span>
        </a>
        <div class="nav-links primary-nav">
            <div class="nav-group nav-mega">
                <span class="nav-root @ActiveGroup("/Index", "/Summary")" tabindex="0">Resumen</span>
                <div class="nav-submenu nav-mega-panel">
                    <section>
                        <strong>Crypto</strong>
                        <a asp-page="/Summary" asp-route-Mercado="crypto" asp-route-VistaResumen="ia">Operaciones otras IAs</a>
                        <a asp-page="/Summary" asp-route-Mercado="crypto" asp-route-VistaResumen="propio">Operaciones IA propia</a>
                        <a asp-page="/Summary" asp-route-Mercado="crypto" asp-route-VistaResumen="traders">Operaciones traders</a>
                    </section>
                    <section>
                        <strong>Forex</strong>
                        <a asp-page="/Summary" asp-route-Mercado="forex" asp-route-VistaResumen="ia">Operaciones otras IAs</a>
                        <a asp-page="/Summary" asp-route-Mercado="forex" asp-route-VistaResumen="propio">Operaciones IA propia</a>
                        <a asp-page="/Summary" asp-route-Mercado="forex" asp-route-VistaResumen="traders">Operaciones traders</a>
                    </section>
                </div>
            </div>
            <div class="nav-group nav-mega">
                <span class="nav-root @ActiveGroup("/Actions", "/ManagedPositions", "/LiveTraders")" tabindex="0">Mercado en vivo</span>
                <div class="nav-submenu nav-mega-panel">
                    <section>
                        <strong>Crypto</strong>
                        <a asp-page="/Actions" asp-route-Mercado="crypto">Operaciones fijas</a>
                        <a asp-page="/ManagedPositions" asp-route-Mercado="crypto">Seguimiento vivo</a>
                        <a asp-page="/LiveTraders" asp-route-Mercado="crypto">Traders crypto</a>
                    </section>
                    <section>
                        <strong>Forex</strong>
                        <a asp-page="/Actions" asp-route-Mercado="forex">Operaciones fijas</a>
                        <a asp-page="/ManagedPositions" asp-route-Mercado="forex">Seguimiento vivo</a>
                        <a asp-page="/LiveTraders" asp-route-Mercado="forex">Traders forex</a>
                    </section>
                </div>
            </div>
            <div class="nav-group nav-mega wide">
                <span class="nav-root @ActiveGroup("/Reports", "/Portfolio", "/Traders")" tabindex="0">Análisis</span>
                <div class="nav-submenu nav-mega-panel nav-analysis-panel">
                    <section>
                        <strong>Crypto reportes</strong>
                        <a asp-page="/Reports" asp-route-Mercado="crypto" asp-route-VistaReporte="ia">IA ajena</a>
                        <a asp-page="/Reports" asp-route-Mercado="crypto" asp-route-VistaReporte="propio">IA propia</a>
                        <a asp-page="/Traders" asp-route-Mercado="crypto">Reporte traders</a>
                    </section>
                    <section>
                        <strong>Crypto simulador</strong>
                        <a asp-page="/Portfolio" asp-route-Mercado="crypto" asp-route-VistaSimulador="ia">Operación ajena</a>
                        <a asp-page="/Portfolio" asp-route-Mercado="crypto" asp-route-VistaSimulador="propio">Operación propia</a>
                        <a asp-page="/Portfolio" asp-route-Mercado="crypto" asp-route-VistaSimulador="traders">Operaciones traders</a>
                    </section>
                    <section>
                        <strong>Forex reportes</strong>
                        <a asp-page="/Reports" asp-route-Mercado="forex" asp-route-VistaReporte="ia">IA ajena</a>
                        <a asp-page="/Reports" asp-route-Mercado="forex" asp-route-VistaReporte="propio">IA propia</a>
                        <a asp-page="/Traders" asp-route-Mercado="forex">Reporte traders</a>
                    </section>
                    <section>
                        <strong>Forex simulador</strong>
                        <a asp-page="/Portfolio" asp-route-Mercado="forex" asp-route-VistaSimulador="ia">Operación ajena</a>
                        <a asp-page="/Portfolio" asp-route-Mercado="forex" asp-route-VistaSimulador="propio">Operación propia</a>
                        <a asp-page="/Portfolio" asp-route-Mercado="forex" asp-route-VistaSimulador="traders">Operaciones traders</a>
                    </section>
                </div>
            </div>
            <div class="nav-group">
                <span class="nav-root @Active("/AprendizajeIa")" tabindex="0">Aprendizaje IA</span>
                <div class="nav-submenu">
                    <a asp-page="/AprendizajeIa" asp-route-Mercado="crypto">Crypto</a>
                    <a asp-page="/AprendizajeIa" asp-route-Mercado="forex">Forex</a>
                </div>
            </div>
            <div class="nav-group">
                <span class="nav-root @Active("/Wallet")" tabindex="0">Wallet</span>
                <div class="nav-submenu">
                    <a asp-page="/Wallet" asp-route-Mercado="crypto">Crypto</a>
                    <a asp-page="/Wallet" asp-route-Mercado="forex">Forex</a>
                </div>
            </div>
            <div class="nav-group">
                <span class="nav-root @Active("/Connections")" tabindex="0">Conexiones</span>
                <div class="nav-submenu">
                    <a asp-page="/Connections" asp-route-Ambito="crypto">Crypto</a>
                    <a asp-page="/Connections" asp-route-Ambito="forex">Forex</a>
                    <a asp-page="/Connections" asp-route-Ambito="traders">Traders</a>
                </div>
            </div>
            <div class="nav-group">
                <span class="nav-root @Active("/Logs")" tabindex="0">Logs</span>
                <div class="nav-submenu">
                    <a asp-page="/Logs" asp-route-Ambito="crypto">Crypto</a>
                    <a asp-page="/Logs" asp-route-Ambito="forex">Forex</a>
                    <a asp-page="/Logs" asp-route-Ambito="traders">Traders</a>
                </div>
            </div>
        </div>
        <label class="theme-toggle" title="Cambiar modo">
            <input id="themeToggle" type="checkbox" aria-label="Modo oscuro"/>
            <span></span>
            <em>Dark</em>
        </label>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" asp-page="/Account/Logout" class="logout-form">
                <button type="submit" class="logout-button" title="Cerrar sesión">Salir</button>
            </form>
        }
    </nav>
</header>

<main role="main">
    @RenderBody()
</main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
