@page "/cartera"
@model PortfolioModel
@{
    ViewData["Title"] = "Cartera";
}

<section class="dashboard">
    <div class="page-head">
        <div>
            <p class="eyebrow">Simulador compuesto</p>
            <h1>Cartera virtual</h1>
        </div>
        <form method="get" class="filter-bar portfolio-filter">
            <label>
                <span>Monto inicial</span>
                <input asp-for="InitialCapital" type="number" min="0.01" step="0.01"/>
            </label>
            <label>
                <span>Activo</span>
                <select asp-for="Symbol">
                    <option value="">Todos</option>
                    @foreach (var symbol in Model.Symbols)
                    {
                        <option value="@symbol">@symbol</option>
                    }
                </select>
            </label>
            <label>
                <span>Tipo de senal</span>
                <select asp-for="TipoSenal">
                    <option value="">Todas</option>
                    <option value="@Model.BuyLowSellHighValue">Compra bajo - vende alto</option>
                    <option value="@Model.SellHighBuyLowValue">Vende alto - compra bajo</option>
                </select>
            </label>
            <label>
                <span>Desde</span>
                <input asp-for="Desde" type="date"/>
            </label>
            <label>
                <span>Hasta</span>
                <input asp-for="Hasta" type="date"/>
            </label>
            <label>
                <span>Score min</span>
                <input asp-for="ScoreMinimo" type="number" min="0" max="100" step="5"/>
            </label>
            <label>
                <span>Trader</span>
                <select asp-for="TraderId">
                    <option value="">Sin trader</option>
                    @foreach (var trader in Model.Traders)
                    {
                        <option value="@trader.Id">@trader.Platform - @trader.DisplayName</option>
                    }
                </select>
            </label>
            <button type="submit">Simular</button>
        </form>
    </div>

    <div class="insight-strip">
        <span>Regla</span>
        <strong>Usa todo el saldo en cada senal cerrada. Si no tienes BTC/ETH, filtra por Compra bajo - vende alto para simular operaciones spot normales.</strong>
    </div>

    <section class="metrics-grid metrics-grid-four" aria-label="Resumen cartera virtual">
        <article class="metric">
            <span>Saldo final</span>
            <strong class="@Model.ResultClass(Model.Simulation.NetPnL)">@Model.Money(Model.Simulation.FinalBalance)</strong>
            <small>inicio @Model.Money(Model.Simulation.InitialCapital)</small>
        </article>
        <article class="metric">
            <span>Resultado neto</span>
            <strong class="@Model.ResultClass(Model.Simulation.NetPnL)">@Model.Money(Model.Simulation.NetPnL)</strong>
            <small>@Model.Simulation.ReturnPercent.ToString("N2")%</small>
        </article>
        <article class="metric">
            <span>Operaciones usadas</span>
            <strong>@Model.Simulation.AppliedTrades</strong>
            <small>@Model.Simulation.SkippedTrades omitidas, @Model.WinRate() win rate</small>
        </article>
        <article class="metric">
            <span>Caida maxima</span>
            <strong class="loss">@Model.Simulation.MaxDrawdown.ToString("N2")%</strong>
            <small>pico @Model.Money(Model.Simulation.PeakBalance)</small>
        </article>
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Curva de cartera</h2>
            <span>@Model.FilteredSignals.Count senales en el rango</span>
        </div>
        <div class="equity-chart">
            <svg viewBox="0 0 1000 170" role="img" aria-label="Evolucion de cartera virtual">
                <line x1="0" y1="150" x2="1000" y2="150"></line>
                <polyline points="@Model.EquityPolyline"></polyline>
            </svg>
        </div>
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Si hubieras seguido a un trader</h2>
            <span>@Model.SelectedTraderName()</span>
        </div>

        @if (!Model.TraderId.HasValue)
        {
            <div class="empty-state">
                <strong>Elige un trader para simular.</strong>
                <span>El simulador usara sus trades cerrados importados o conectados y pondra todo el saldo en cada operacion.</span>
                <a asp-page="/Traders">Ver traders disponibles</a>
            </div>
        }
        else if (Model.TraderSimulation.Trades.Count == 0)
        {
            <div class="empty-state">
                <strong>Este trader aun no tiene historial local.</strong>
                <span>La plataforma puede mostrar perfil/ranking publico, pero no hay trades reales importados para calcular cartera.</span>
                <a asp-page="/Traders" asp-route-TraderId="@Model.TraderId">Ver ficha del trader</a>
            </div>
        }
        else
        {
            <section class="metrics-grid metrics-grid-four" aria-label="Resumen cartera por trader">
                <article class="metric">
                    <span>Saldo final trader</span>
                    <strong class="@Model.ResultClass(Model.TraderSimulation.NetPnL)">@Model.Money(Model.TraderSimulation.FinalBalance)</strong>
                    <small>inicio @Model.Money(Model.TraderSimulation.InitialCapital)</small>
                </article>
                <article class="metric">
                    <span>Resultado trader</span>
                    <strong class="@Model.ResultClass(Model.TraderSimulation.NetPnL)">@Model.Money(Model.TraderSimulation.NetPnL)</strong>
                    <small>@Model.TraderSimulation.ReturnPercent.ToString("N2")%</small>
                </article>
                <article class="metric">
                    <span>Trades usados</span>
                    <strong>@Model.TraderSimulation.AppliedTrades</strong>
                    <small>@Model.TraderSimulation.SkippedTrades omitidos, @Model.TraderWinRate() win rate</small>
                </article>
                <article class="metric">
                    <span>Caida maxima trader</span>
                    <strong class="loss">@Model.TraderSimulation.MaxDrawdown.ToString("N2")%</strong>
                    <small>pico @Model.Money(Model.TraderSimulation.PeakBalance)</small>
                </article>
            </section>

            <div class="equity-chart trader-equity-chart">
                <svg viewBox="0 0 1000 170" role="img" aria-label="Evolucion de cartera siguiendo trader">
                    <line x1="0" y1="150" x2="1000" y2="150"></line>
                    <polyline points="@Model.TraderEquityPolyline"></polyline>
                </svg>
            </div>

            <div class="master-detail portfolio-workbench" data-master-detail>
                <div class="master-list" aria-label="Trades simulados del trader">
                    @for (var index = 0; index < Model.TraderSimulation.Trades.Count; index++)
                    {
                        var row = Model.TraderSimulation.Trades[index];
                        var key = $"trader-{row.Sequence}";
                        <button type="button"
                                class="master-item @(index == 0 ? "active" : "") @(row.WasApplied ? "" : "muted-row")"
                                data-detail-key="@key"
                                data-filter-text="@($"{row.TraderName} {row.Platform} {row.Symbol} {row.SignalType} {row.OpenedAt.ToLocalTime():dd MMM HH:mm} {row.SkipReason}")"
                                data-filter-status="@(row.WasApplied ? "Aplicada" : "Omitida")"
                                data-filter-type="@row.SignalType">
                            <span class="master-kicker">#@row.Sequence | @row.Platform</span>
                            <strong>@row.TraderName - @row.Symbol</strong>
                            <small>@row.SignalType | @row.OpenedAt.ToLocalTime().ToString("dd MMM HH:mm")</small>
                            <span class="@Model.ResultClass(row.NetPnL)">@(row.WasApplied ? Model.Money(row.NetPnL) : row.SkipReason)</span>
                            <div class="master-item-extra">
                                <span>Antes @Model.Money(row.StartingBalance)</span>
                                <span>Despues @Model.Money(row.EndingBalance)</span>
                            </div>
                        </button>
                    }
                </div>
                <div class="detail-stack">
                    @for (var index = 0; index < Model.TraderSimulation.Trades.Count; index++)
                    {
                        var row = Model.TraderSimulation.Trades[index];
                        var key = $"trader-{row.Sequence}";
                        <article class="detail-panel @(index == 0 ? "active" : "")" data-detail-panel="@key">
                            <div class="section-title">
                                <h2>#@row.Sequence @row.Symbol</h2>
                                <span>@row.TraderName | @row.SignalType</span>
                            </div>
                            <div class="detail-grid">
                                <article><span>Entrada</span><strong>@row.OpenedAt.ToLocalTime().ToString("dd MMM HH:mm")</strong><small>@Model.Price(row.EntryPrice)</small></article>
                                <article><span>Salida</span><strong>@(row.ClosedAt.HasValue ? row.ClosedAt.Value.ToLocalTime().ToString("dd MMM HH:mm") : "-")</strong><small>@(row.ExitPrice.HasValue ? Model.Price(row.ExitPrice.Value) : row.SkipReason)</small></article>
                                <article><span>Saldo antes</span><strong>@Model.Money(row.StartingBalance)</strong><small>capital completo</small></article>
                                <article><span>Cantidad</span><strong>@(row.WasApplied ? Model.Quantity(row) : "-")</strong><small>simulada</small></article>
                                <article><span>Comision</span><strong>@Model.Money(row.Fees)</strong><small>ida y vuelta</small></article>
                                <article><span>Resultado</span><strong class="@Model.ResultClass(row.NetPnL)">@(row.WasApplied ? Model.Money(row.NetPnL) : row.SkipReason)</strong><small>@(row.WasApplied ? $"{row.ReturnPercent:N2}%" : "")</small></article>
                                <article><span>Saldo despues</span><strong>@Model.Money(row.EndingBalance)</strong><small>compuesto</small></article>
                                <article><span>Estado</span><strong>@(row.WasApplied ? "Aplicada" : "Omitida")</strong><small>@row.SkipReason</small></article>
                            </div>
                        </article>
                    }
                </div>
            </div>
        }
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Secuencia compuesta</h2>
            <span>saldo completo por senal</span>
        </div>

        @if (Model.Simulation.Trades.Count == 0)
        {
            <div class="empty-state">
                <strong>Sin senales para simular.</strong>
                <span>Cambia el rango de fechas, activo o score minimo.</span>
            </div>
        }
        else
        {
            <div class="master-detail portfolio-workbench" data-master-detail>
                <div class="master-list" aria-label="Secuencia compuesta">
                    @for (var index = 0; index < Model.Simulation.Trades.Count; index++)
                    {
                        var row = Model.Simulation.Trades[index];
                        var key = $"portfolio-{row.Sequence}";
                        <button type="button"
                                class="master-item @(index == 0 ? "active" : "") @(row.WasApplied ? "" : "muted-row")"
                                data-detail-key="@key"
                                data-filter-text="@($"{row.Symbol} {row.OperationType} {row.Horizon} {row.SignalTime.ToLocalTime():dd MMM HH:mm} {row.SkipReason}")"
                                data-filter-status="@(row.WasApplied ? "Aplicada" : "Omitida")"
                                data-filter-type="@row.OperationType">
                            <span class="master-kicker">#@row.Sequence | @row.SignalTime.ToLocalTime().ToString("dd MMM HH:mm")</span>
                            <strong>@row.Symbol - @row.OperationType</strong>
                            <small>@row.Horizon | entrada @Model.Price(row.EntryPrice)</small>
                            <span class="@Model.ResultClass(row.NetPnL)">@(row.WasApplied ? Model.Money(row.NetPnL) : Model.AppliedLabel(row))</span>
                            <div class="master-item-extra">
                                <span>Antes @Model.Money(row.StartingBalance)</span>
                                <span>Despues @Model.Money(row.EndingBalance)</span>
                            </div>
                        </button>
                    }
                </div>
                <div class="detail-stack">
                    @for (var index = 0; index < Model.Simulation.Trades.Count; index++)
                    {
                        var row = Model.Simulation.Trades[index];
                        var key = $"portfolio-{row.Sequence}";
                        <article class="detail-panel @(index == 0 ? "active" : "")" data-detail-panel="@key">
                            <div class="section-title">
                                <h2>#@row.Sequence @row.Symbol</h2>
                                <span>@row.OperationType | @row.Horizon</span>
                            </div>
                            <div class="detail-grid">
                                <article><span>Senal</span><strong>@row.SignalTime.ToLocalTime().ToString("dd MMM HH:mm")</strong><small>@row.Horizon</small></article>
                                <article><span>Entrada</span><strong>@row.EntryTime.ToLocalTime().ToString("HH:mm")</strong><small>@Model.Price(row.EntryPrice)</small></article>
                                <article><span>Salida</span><strong>@(row.ExitTime.HasValue ? row.ExitTime.Value.ToLocalTime().ToString("dd MMM HH:mm") : "-")</strong><small>@(row.ExitPrice.HasValue ? Model.Price(row.ExitPrice.Value) : row.SkipReason)</small></article>
                                <article><span>Saldo antes</span><strong>@Model.Money(row.StartingBalance)</strong><small>todo el saldo</small></article>
                                <article><span>Cantidad comprada/vendida</span><strong>@(row.WasApplied ? Model.Quantity(row) : "-")</strong><small>empate @Model.Price(Model.BreakEvenPrice(row))</small></article>
                                <article><span>Comision</span><strong>@Model.Money(row.Fees)</strong><small>costo estimado</small></article>
                                <article><span>Resultado</span><strong class="@Model.ResultClass(row.NetPnL)">@(row.WasApplied ? Model.Money(row.NetPnL) : Model.AppliedLabel(row))</strong><small>@(row.WasApplied ? $"{row.ReturnPercent:N2}%" : "")</small></article>
                                <article><span>Saldo despues</span><strong>@Model.Money(row.EndingBalance)</strong><small>@Model.AppliedLabel(row)</small></article>
                            </div>
                        </article>
                    }
                </div>
            </div>
        }
    </section>
</section>

@section Scripts {
    <script src="~/js/master-detail.js" asp-append-version="true"></script>
}
