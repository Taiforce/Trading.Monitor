@page "/reportes"
@model ReportsModel
@{
    ViewData["Title"] = "Reportes";
}

<section class="dashboard">
    <div class="page-head">
        <div>
            <p class="eyebrow">Analitica del trader</p>
            <h1>Reportes</h1>
        </div>
        <form method="get" class="filter-bar reports-filter">
            <label>
                <span>Monto</span>
                <input asp-for="Capital" type="number" min="0.01" step="0.01"/>
            </label>
            <label>
                <span>Estado</span>
                <select asp-for="Estado">
                    <option value="todas">Todas</option>
                    <option value="abiertas">Abiertas</option>
                    <option value="cerradas">Cerradas</option>
                    <option value="ganadas">Ganadas</option>
                    <option value="perdidas">Perdidas</option>
                </select>
            </label>
            <label>
                <span>Activo</span>
                <select asp-for="Symbol">
                    <option value="">Todos</option>
                    @foreach (var symbol in Model.Symbols)
                    {
                        <option value="@symbol">@symbol</option>
                    }
                </select>
            </label>
            <label>
                <span>Tipo de senal</span>
                <select asp-for="TipoSenal">
                    <option value="">Todas</option>
                    <option value="@Model.BuyLowSellHighValue">Compra bajo - vende alto</option>
                    <option value="@Model.SellHighBuyLowValue">Vende alto - compra bajo</option>
                </select>
            </label>
            <label>
                <span>Desde</span>
                <input asp-for="Desde" type="date"/>
            </label>
            <label>
                <span>Hasta</span>
                <input asp-for="Hasta" type="date"/>
            </label>
            <label>
                <span>Score min</span>
                <input asp-for="ScoreMinimo" type="number" min="0" max="100" step="5"/>
            </label>
            <button type="submit">Filtrar</button>
        </form>
    </div>

    <div class="insight-strip">
        <span>Lectura ejecutiva</span>
        <strong>@Model.ExecutiveReadout</strong>
    </div>

    <section class="metrics-grid metrics-grid-four" aria-label="Resumen de reportes">
        <article class="metric">
            <span>Win rate</span>
            <strong>@Model.FilteredWinRate.ToString("N2")%</strong>
            <small>@Model.FilteredWinners ganadoras, @Model.FilteredLosers perdedoras</small>
        </article>
        <article class="metric">
            <span>Score promedio</span>
            <strong>@Model.FilteredAverageScore.ToString("N1")</strong>
            <small>calidad media</small>
        </article>
        <article class="metric">
            <span>Mejor simbolo</span>
            <strong>@(Model.BestSymbol?.Symbol ?? "-")</strong>
            <small>@Model.Money(Model.BestSymbol?.RealizedNetPnL ?? 0m) realizado</small>
        </article>
        <article class="metric">
            <span>Promedio por senal</span>
            <strong class="gain">@Model.Money(Model.AveragePotentialTp1)</strong>
            <small>si llegaba a ganancia objetivo</small>
        </article>
    </section>

    <section class="metrics-grid metrics-grid-four" aria-label="Riesgo y comparativos">
        <article class="metric metric-soft">
            <span>Peor simbolo</span>
            <strong>@(Model.WorstSymbol?.Symbol ?? "-")</strong>
            <small>@Model.Money(Model.WorstSymbol?.RealizedNetPnL ?? 0m) realizado</small>
        </article>
        <article class="metric metric-soft">
            <span>Mejor dia</span>
            <strong>@(Model.BestDay?.Day.ToString("dd MMM") ?? "-")</strong>
            <small>@Model.Money(Model.BestDay?.RealizedNetPnL ?? 0m) realizado</small>
        </article>
        <article class="metric metric-soft">
            <span>Perdida maxima promedio</span>
            <strong class="loss">@Model.Money(Model.AverageStopLoss)</strong>
            <small>por oportunidad</small>
        </article>
        <article class="metric metric-soft">
            <span>Oportunidades cerradas</span>
            <strong>@Model.FilteredClosedSignals</strong>
            <small>base real para evaluar</small>
        </article>
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Calidad operativa</h2>
            <span>senales remarcadas</span>
        </div>
        <div class="guide-grid">
            <article>
                <strong>@Model.HighConvictionRows.Count</strong>
                <span>Senales con score fuerte y riesgo controlado.</span>
            </article>
            <article>
                <strong class="gain">@Model.Money(Model.AverageHighConvictionTp1)</strong>
                <span>Ganancia objetivo promedio.</span>
            </article>
            <article>
                <strong class="loss">@Model.Money(Model.AverageHighConvictionStop)</strong>
                <span>Perdida maxima promedio.</span>
            </article>
            <article>
                <strong>@Model.FilteredOpenSignals</strong>
                <span>Abiertas con salida pendiente.</span>
            </article>
        </div>
    </section>

    <section class="two-column">
        <div class="report-section">
            <div class="section-title">
                <h2>Por simbolo</h2>
                <span>ganancia y dano</span>
            </div>

            @if (Model.FilteredSymbolBreakdown.Count == 0)
            {
                <div class="empty-state">
                    <strong>Sin senales por simbolo.</strong>
                    <span>Cuando aparezcan oportunidades, este reporte separara rendimiento por activo.</span>
                </div>
            }
            else
            {
                <div class="symbol-list">
                    @foreach (var row in Model.FilteredSymbolBreakdown)
                    {
                        <article class="symbol-row">
                            <div>
                                <strong>@row.Symbol</strong>
                                <span>@row.TotalSignals senales, @row.OpenSignals abiertas</span>
                            </div>
                            <div class="bar-set">
                                <div class="bar gain-bar" style="width:@Model.BarWidth(row.PotentialNetAtTakeProfit1, Model.MaxSymbolValue)%"></div>
                                <div class="bar loss-bar" style="width:@Model.BarWidth(row.PotentialLossAtStop, Model.MaxSymbolValue)%"></div>
                            </div>
                            <div class="row-money">
                                <span class="gain">@Model.Money(row.PotentialNetAtTakeProfit1)</span>
                                <span class="loss">@Model.Money(row.PotentialLossAtStop)</span>
                            </div>
                            <p class="row-note">
                                @row.Winners ganadas, @row.Losers perdidas, @Model.Money(row.RealizedNetPnL) realizado.
                            </p>
                        </article>
                    }
                </div>
            }
        </div>

        <div class="report-section">
            <div class="section-title">
                <h2>Por dia</h2>
                <span>ultimos 30 dias</span>
            </div>

            @if (Model.FilteredDailyBreakdown.Count == 0)
            {
                <div class="empty-state">
                    <strong>Sin dias para reportar.</strong>
                    <span>El historial diario se llenara con el paso de los barridos.</span>
                </div>
            }
            else
            {
                <div class="daily-list">
                    @foreach (var row in Model.FilteredDailyBreakdown)
                    {
                        <article class="daily-row">
                            <strong>@row.Day.ToString("dd MMM yyyy")</strong>
                            <span>@row.TotalSignals senales</span>
                            <span class="@Model.SignedClass(row.RealizedNetPnL)">@Model.Money(row.RealizedNetPnL)</span>
                            <span class="gain">@Model.Money(row.PotentialNetAtTakeProfit1)</span>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Operaciones claras</h2>
            <span>@Model.FilteredRows.Count senales filtradas</span>
        </div>

        @if (Model.FilteredRows.Count == 0)
        {
            <div class="empty-state">
                <strong>Sin operaciones para esos filtros.</strong>
                <span>Cambia rango, activo, estado o score minimo.</span>
            </div>
        }
        else
        {
            <div class="signal-summary-grid">
                @foreach (var row in Model.FilteredRows.Take(60))
                {
                    var conversion = Model.ConversionFor(row);
                    <article class="signal-summary-card">
                        <header>
                            <div>
                                <strong>@row.Symbol</strong>
                                <span>@Model.SignalTypeLabel(row.Side) | @Model.HorizonFor(row) | score @row.Score</span>
                            </div>
                            <span class="status @Model.StatusClass(row.Status)">@Model.StatusLabel(row.Status)</span>
                        </header>

                        <div class="signal-fast-grid">
                            <div>
                                <span>Recibi</span>
                                <strong>@row.ObservedAt.ToLocalTime().ToString("dd MMM HH:mm")</strong>
                            </div>
                            <div>
                                <span>Operacion</span>
                                <strong>@Model.OperationType(row)</strong>
                                <small>@Model.OperationMeaning(row)</small>
                            </div>
                            <div>
                                <span>Entrar</span>
                                <strong>@Model.EntryWindow(row)</strong>
                                <small>@Model.Price(row.EntryPrice)</small>
                            </div>
                            <div>
                                <span>Terminar</span>
                                <strong>@Model.ExitLimit(row)</strong>
                                <small>@(row.ExitPrice.HasValue ? Model.Price(row.ExitPrice.Value) : "pendiente")</small>
                            </div>
                        </div>

                        <div class="signal-money-grid">
                            <div>
                                <span>Simulador</span>
                                <strong>@Model.SimulationLine(row)</strong>
                            </div>
                            <div>
                                <span>Comision</span>
                                <strong>@Model.Money(conversion.EstimatedFees)</strong>
                                <small>@conversion.BreakEvenMovePercent.ToString("N2")% para empatar</small>
                            </div>
                            <div>
                                <span>Empate</span>
                                <strong>@Model.Price(conversion.BreakEvenPrice)</strong>
                                <small>precio minimo para no perder</small>
                            </div>
                            <div>
                                <span>Ganar neto</span>
                                <strong class="gain">@Model.Money(row.NetProfitAtTakeProfit1)</strong>
                            </div>
                            <div>
                                <span>Perder neto</span>
                                <strong class="loss">@Model.Money(row.NetLossAtStop)</strong>
                            </div>
                            <div>
                                <span>Real</span>
                                <strong class="@Model.SignedClass(row.RealizedNetPnL)">@Model.RealNet(row)</strong>
                                <small>total @Model.RealTotal(conversion)</small>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Como leer estos numeros</h2>
            <span>guia rapida</span>
        </div>
        <div class="guide-grid">
            <article>
                <strong>Win rate</strong>
                <span>% de cerradas con ganancia.</span>
            </article>
            <article>
                <strong>Score</strong>
                <span>Fuerza de la senal.</span>
            </article>
            <article>
                <strong>Compra bajo</strong>
                <span>Compras con dinero y vendes mas caro.</span>
            </article>
            <article>
                <strong>Vende alto</strong>
                <span>Vendes primero y recompras mas barato; requiere moneda, margen o futuros.</span>
            </article>
        </div>
    </section>
</section>
