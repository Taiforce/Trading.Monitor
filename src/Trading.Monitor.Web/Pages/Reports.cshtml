@page "/reportes"
@model ReportsModel
@{
    ViewData["Title"] = "Reportes";
}

<section class="dashboard">
    <div class="page-head">
        <div>
            <p class="eyebrow">@Model.MarketLabel() | analítica del trader</p>
            <h1>Reportes</h1>
        </div>
    </div>

    <div class="insight-strip">
        <span>Lectura ejecutiva</span>
        <strong>@Model.ExecutiveReadout</strong>
    </div>

    <section class="metrics-grid metrics-grid-four" aria-label="Resumen de reportes">
        <article class="metric">
            <span>Win rate</span>
            <strong>@Model.FilteredWinRate.ToString("N2")%</strong>
            <small>@Model.FilteredWinners ganadoras, @Model.FilteredLosers perdedoras</small>
        </article>
        <article class="metric">
            <span>Score promedio</span>
            <strong>@Model.FilteredAverageScore.ToString("N1")</strong>
            <small>calidad media</small>
        </article>
        <article class="metric">
            <span>Mejor simbolo</span>
            <strong>@(Model.BestSymbol?.Symbol ?? "-")</strong>
            <small>@Model.Money(Model.BestSymbol?.RealizedNetPnL ?? 0m) realizado</small>
        </article>
        <article class="metric">
            <span>Promedio por señal</span>
            <strong class="gain">@Model.Money(Model.AveragePotentialTp1)</strong>
            <small>si llegaba a ganancia objetivo</small>
        </article>
    </section>

    <section class="metrics-grid metrics-grid-four" aria-label="Riesgo y comparativos">
        <article class="metric metric-soft">
            <span>Peor simbolo</span>
            <strong>@(Model.WorstSymbol?.Symbol ?? "-")</strong>
            <small>@Model.Money(Model.WorstSymbol?.RealizedNetPnL ?? 0m) realizado</small>
        </article>
        <article class="metric metric-soft">
            <span>Mejor dia</span>
            <strong>@(Model.BestDay?.Day.ToString("dd MMM") ?? "-")</strong>
            <small>@Model.Money(Model.BestDay?.RealizedNetPnL ?? 0m) realizado</small>
        </article>
        <article class="metric metric-soft">
            <span>Pérdida máxima promedio</span>
            <strong class="loss">@Model.Money(Model.AverageStopLoss)</strong>
            <small>por oportunidad</small>
        </article>
        <article class="metric metric-soft">
            <span>Oportunidades cerradas</span>
            <strong>@Model.FilteredClosedSignals</strong>
            <small>base real para evaluar</small>
        </article>
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Calidad operativa</h2>
            <span>señales remarcadas</span>
        </div>
        <div class="guide-grid">
            <article>
                <strong>@Model.HighConvictionRows.Count</strong>
                <span>Señales con score fuerte y riesgo controlado.</span>
            </article>
            <article>
                <strong class="gain">@Model.Money(Model.AverageHighConvictionTp1)</strong>
                <span>Ganancia objetivo promedio.</span>
            </article>
            <article>
                <strong class="loss">@Model.Money(Model.AverageHighConvictionStop)</strong>
                <span>Pérdida máxima promedio.</span>
            </article>
            <article>
                <strong>@Model.FilteredClosedSignals</strong>
                <span>Cierres medidos después de comisiones.</span>
            </article>
        </div>
    </section>

    @if (Model.VistaReporte == "ia")
    {
    <section class="report-section">
        <div class="section-title">
            <h2>IA ajena capturada</h2>
            <span>señales externas filtradas</span>
        </div>
        <div class="insight-strip compact-insight">
            <span>Regla principal</span>
            <strong>No existe 100% garantizado. Aquí se muestran solo señales marcadas como externas y se filtran por ventaja neta después de comisiones, confirmaciones y riesgo controlado.</strong>
        </div>
        @if (Model.AiConsensusRows.Count == 0)
        {
            <div class="empty-state">
                <strong>Sin señales para evaluar.</strong>
                <span>Aplica menos filtros o espera a que el servicio registre nuevas oportunidades.</span>
            </div>
        }
        else
        {
            <div class="ai-consensus-grid">
                @foreach (var row in Model.AiConsensusRows)
                {
                    <article class="ai-consensus-card @Model.ConsensusClass(row)">
                        <header>
                            <div>
                                <span>@row.Symbol</span>
                                <strong>@row.CompositeScore/100</strong>
                            </div>
                            <em>@Model.ConsensusAction(row)</em>
                        </header>
                        <h3>@row.ConsensusLabel</h3>
                        <p>@row.PlainReadout</p>
                        <div class="ai-chip-row">
                            @foreach (var modelScore in row.TopModels)
                            {
                                <span title="@modelScore.Why">@modelScore.Name @modelScore.Score</span>
                            }
                        </div>
                        @if (row.VetoReasons.Count > 0)
                        {
                            <details class="compact-details">
                                <summary>Ver bloqueos</summary>
                                <div class="ai-veto-list">
                                    @foreach (var reason in row.VetoReasons)
                                    {
                                        <span>@reason</span>
                                    }
                                </div>
                            </details>
                        }
                    </article>
                }
            </div>
        }
    </section>
    }

    @if (Model.VistaReporte == "propio")
    {
    <section class="report-section">
        <div class="section-title">
            <h2>Aprendizaje propio</h2>
            <span>retroalimentacion real</span>
        </div>
        <div class="insight-strip compact-insight">
            <span>Autoajuste</span>
            <strong>@Model.LearningReadout</strong>
        </div>
        @if (Model.LearningRows.Count == 0)
        {
            <div class="empty-state">
                <strong>Todavia no hay patrones cerrados.</strong>
                <span>Cuando las señales terminen, el sistema comparará score, tipo, activo y horizonte para endurecer o priorizar reglas.</span>
            </div>
        }
        else
        {
            <div class="learning-grid">
                @foreach (var row in Model.LearningRows)
                {
                    <article class="learning-card">
                        <div>
                            <strong>@row.Pattern</strong>
                            <span class="@row.ClassName">@row.Recommendation</span>
                        </div>
                        <dl>
                            <div><dt>Cierres</dt><dd>@row.TotalSignals</dd></div>
                            <div><dt>Win rate</dt><dd class="@row.ClassName">@row.WinRate.ToString("N1")%</dd></div>
                            <div><dt>Neto</dt><dd class="@Model.SignedClass(row.RealizedNetPnL)">@Model.Money(row.RealizedNetPnL)</dd></div>
                            <div><dt>Score prom</dt><dd>@row.AverageScore.ToString("N1")</dd></div>
                        </dl>
                    </article>
                }
            </div>
        }
    </section>
    }

    <section class="two-column">
        <div class="report-section">
            <div class="section-title">
                <h2>Por simbolo</h2>
                <span>real cerrado vs potencial</span>
            </div>

            @if (Model.FilteredSymbolBreakdown.Count == 0)
            {
                <div class="empty-state">
                    <strong>Sin señales por símbolo.</strong>
                    <span>Cuando aparezcan oportunidades, este reporte separara rendimiento por activo.</span>
                </div>
            }
            else
            {
                <div class="symbol-list">
                    @foreach (var row in Model.FilteredSymbolBreakdown)
                    {
                        <article class="symbol-row">
                            <div>
                                <strong>@row.Symbol</strong>
                                <small>Real cerrado y potencial teórico separados.</small>
                                <span>@row.TotalSignals señales, @row.OpenSignals abiertas</span>
                            </div>
                            <div class="bar-set">
                                <div class="bar gain-bar" style="width:@Model.BarWidth(row.PotentialNetAtTakeProfit1, Model.MaxSymbolValue)%"></div>
                                <div class="bar loss-bar" style="width:@Model.BarWidth(row.PotentialLossAtStop, Model.MaxSymbolValue)%"></div>
                            </div>
                            <div class="row-money">
                                <span class="@Model.SignedClass(row.RealizedNetPnL)">Real @Model.Money(row.RealizedNetPnL)</span>
                                <span class="gain">@Model.Money(row.PotentialNetAtTakeProfit1)</span>
                                <span class="loss">@Model.Money(row.PotentialLossAtStop)</span>
                            </div>
                            <p class="row-note">
                                @row.Winners ganadas, @row.Losers pérdidas, @Model.Money(row.RealizedNetPnL) realizado.
                            </p>
                        </article>
                    }
                </div>
            }
        </div>

        <div class="report-section">
            <div class="section-title">
                <h2>Por dia</h2>
                <span>real cerrado y potencial</span>
            </div>

            @if (Model.FilteredDailyBreakdown.Count == 0)
            {
                <div class="empty-state">
                    <strong>Sin dias para reportar.</strong>
                    <span>El historial diario se llenara con el paso de los barridos.</span>
                </div>
            }
            else
            {
                <div class="daily-list">
                    @foreach (var row in Model.FilteredDailyBreakdown)
                    {
                        <article class="daily-row">
                            <strong>@row.Day.ToString("dd MMM yyyy")</strong>
                            <span>@row.TotalSignals señales</span>
                            <span>@row.ClosedSignals cerradas</span>
                            <span class="@Model.SignedClass(row.RealizedNetPnL)">Real @Model.Money(row.RealizedNetPnL)</span>
                            <span class="gain">Potencial @Model.Money(row.PotentialNetAtTakeProfit1)</span>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Operaciones claras</h2>
            <span>@Model.FilteredRows.Count cierres filtrados</span>
        </div>
        <form method="get" class="filter-bar reports-filter internal-report-filter">
            <input asp-for="Mercado" type="hidden"/>
            <input asp-for="VistaReporte" type="hidden"/>
            <label>
                <span>Monto</span>
                <input asp-for="Capital" type="number" min="0.01" step="0.01"/>
            </label>
            <label>
                <span>Resultado</span>
                <select asp-for="Estado">
                    <option value="cerradas">Todas cerradas</option>
                    <option value="ganadas">Ganadas</option>
                    <option value="perdidas">Pérdidas</option>
                </select>
            </label>
            <label>
                <span>Activo</span>
                <select asp-for="Symbol">
                    <option value="">Todos</option>
                    @foreach (var symbol in Model.Symbols)
                    {
                        <option value="@symbol">@Model.SymbolButtonLabel(symbol)</option>
                    }
                </select>
            </label>
            <label>
                <span>Tipo de señal</span>
                <select asp-for="TipoSenal">
                    <option value="">Ambas</option>
                    <option value="@Model.BuyLowSellHighValue">Compra bajo - vende alto</option>
                    <option value="@Model.SellHighBuyLowValue">Vende alto - compra bajo</option>
                </select>
            </label>
            <label>
                <span>Modo</span>
                <select asp-for="ModoOperacion">
                    <option value="">Ambos</option>
                    <option value="fija">Señal fija</option>
                    <option value="seguimiento">Seguimiento</option>
                </select>
            </label>
            <label>
                <span>Desde</span>
                <input asp-for="Desde" type="date"/>
            </label>
            <label>
                <span>Hasta</span>
                <input asp-for="Hasta" type="date"/>
            </label>
            <label>
                <span>Score min</span>
                <input asp-for="ScoreMinimo" type="number" min="0" max="100" step="5"/>
            </label>
            <button type="submit">Filtrar</button>
        </form>

        @if (Model.FilteredRows.Count == 0)
        {
            <div class="empty-state">
                <strong>Sin operaciones para esos filtros.</strong>
                <span>Cambia mercado, rango, activo, tipo o score mínimo.</span>
            </div>
        }
        else
        {
            <div class="master-detail signal-workbench" data-master-detail data-signal-replay>
                <div class="master-list" aria-label="Operaciones filtradas">
                    @for (var index = 0; index < Model.FilteredRows.Count; index++)
                    {
                        var row = Model.FilteredRows[index];
                        var isActive = index == 0;
                        <button type="button"
                                class="master-item @(isActive ? "active" : "")"
                                data-detail-key="@row.Id"
                                data-filter-text="@($"{row.Symbol} {Model.SignalTypeLabel(row.Side)} {Model.StatusLabel(row.Status)} {Model.HorizonFor(row)} score {row.Score} entrada {Model.EntryWindow(row)} salida {Model.ExitLimit(row)}")"
                                data-filter-status="@Model.StatusLabel(row.Status)"
                                data-filter-type="@Model.SignalTypeLabel(row.Side)"
                                data-filter-mode="@Model.OperationModeLabel(row)">
                            <span class="master-kicker">@row.ObservedAt.ToLocalTime().ToString("dd MMM HH:mm") | @Model.HorizonFor(row)</span>
                            <strong>@row.Symbol - @Model.SignalTypeLabel(row.Side)</strong>
                            <span class="status @Model.StatusClass(row.Status)">@Model.StatusLabel(row.Status)</span>
                            <small>@Model.OperationModeLabel(row) | Score @row.Score | real @Model.RealNet(row)</small>
                            <div class="master-item-extra">
                                <span>Entrada @Model.Price(row.EntryPrice)</span>
                                <span>Salida @(row.ExitPrice.HasValue ? Model.Price(row.ExitPrice.Value) : "pendiente")</span>
                                <span class="gain">Ganar @Model.Money(row.NetProfitAtTakeProfit1)</span>
                                <span class="loss">Perder @Model.Money(row.NetLossAtStop)</span>
                            </div>
                        </button>
                    }
                </div>

                <div class="detail-stack">
                    @for (var index = 0; index < Model.FilteredRows.Count; index++)
                    {
                        var row = Model.FilteredRows[index];
                        var conversion = Model.ConversionFor(row);
                        var isActive = index == 0;
                        <article class="detail-panel @(isActive ? "active" : "")"
                                 data-detail-panel="@row.Id"
                                 data-symbol="@row.Symbol"
                                 data-interval="@Model.ChartIntervalFor(row)"
                                 data-capital="@row.Capital.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-from="@Model.ReplayFrom(row).ToString("O")"
                                 data-to="@Model.ReplayTo(row).ToString("O")"
                                 data-side="@row.Side"
                                 data-entry-price="@row.EntryPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-entry-lower="@row.EntryLower.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-entry-upper="@row.EntryUpper.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-stop-loss="@row.StopLoss.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-take-profit1="@row.TakeProfit1.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-take-profit2="@row.TakeProfit2.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-exit-price="@(row.ExitPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                 data-observed-at="@row.ObservedAt.ToString("O")"
                                 data-exit-time="@((row.ExitTime ?? row.ExpiresAt).ToString("O"))"
                                 data-action="@Model.SignalTypeLabel(row.Side)"
                                 data-status="@Model.StatusLabel(row.Status)">
                            <div class="section-title">
                                <h2>@row.Symbol - @Model.SignalTypeLabel(row.Side)</h2>
                                <span>@Model.OperationModeLabel(row) | @Model.StatusLabel(row.Status) | score @row.Score</span>
                            </div>
                            <div class="signal-replay-chart" data-signal-chart>
                                <span>Cargando replay de la señal...</span>
                            </div>
                            <div class="detail-grid">
                                <article>
                                    <span>Señal recibida</span>
                                    <strong>@row.ObservedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</strong>
                                    <small>@Model.OperationModeHint(row)</small>
                                </article>
                                <article>
                                    <span>Momento para entrar</span>
                                    <strong>@Model.EntryWindow(row)</strong>
                                    <small>@Model.Price(row.EntryPrice)</small>
                                </article>
                                <article>
                                    <span>Fecha limite de salida</span>
                                    <strong>@Model.ExitLimit(row)</strong>
                                    <small>@(row.ExitPrice.HasValue ? Model.Price(row.ExitPrice.Value) : "pendiente")</small>
                                </article>
                                <article>
                                    <span>Simulador</span>
                                    <strong>@Model.SimulationLine(row)</strong>
                                    <small>@conversion.EntryText</small>
                                </article>
                                <article>
                                    <span>Ganar neto</span>
                                    <strong class="gain">@Model.Money(row.NetProfitAtTakeProfit1)</strong>
                                    <small>objetivo @Model.Price(row.TakeProfit1)</small>
                                </article>
                                <article>
                                    <span>Perder maximo</span>
                                    <strong class="loss">@Model.Money(row.NetLossAtStop)</strong>
                                    <small>corte @Model.Price(row.StopLoss)</small>
                                </article>
                                <article>
                                    <span>Resultado real</span>
                                    <strong class="@Model.SignedClass(row.RealizedNetPnL)">@Model.RealNet(row)</strong>
                                    <small>total @Model.RealTotal(conversion)</small>
                                </article>
                                <article>
                                    <span>Comisión y empate</span>
                                    <strong>@Model.Money(conversion.EstimatedFees)</strong>
                                    <small>@conversion.BreakEvenText</small>
                                </article>
                            </div>
                            <details class="compact-details">
                                <summary>Ver razones y riesgos</summary>
                                <div class="detail-notes">
                                    <div>
                                        <strong>Razones</strong>
                                        @foreach (var note in Model.SplitNotes(row.Reasons))
                                        {
                                            <span>@note</span>
                                        }
                                    </div>
                                    <div>
                                        <strong>Riesgos</strong>
                                        @foreach (var note in Model.SplitNotes(row.Risks))
                                        {
                                            <span>@note</span>
                                        }
                                    </div>
                                </div>
                            </details>
                        </article>
                    }
                </div>
            </div>
        }
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Como leer estos numeros</h2>
            <span>guia rapida</span>
        </div>
        <div class="guide-grid">
            <article>
                <strong>Win rate</strong>
                <span>% de cerradas con ganancia.</span>
            </article>
            <article>
                <strong>Score</strong>
                <span>Fuerza de la señal.</span>
            </article>
            <article>
                <strong>Compra bajo</strong>
                <span>Compras con dinero y vendes más caro.</span>
            </article>
            <article>
                <strong>Vende alto</strong>
                <span>Vendes primero y recompras más barato; requiere moneda, margen o futuros.</span>
            </article>
        </div>
    </section>
</section>

@section Scripts {
    <script src="~/lib/lightweight-charts/lightweight-charts.standalone.production.js"></script>
    <script src="~/js/master-detail.js" asp-append-version="true"></script>
}
