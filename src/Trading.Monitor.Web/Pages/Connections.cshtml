@page "/conexiones"
@model ConnectionsModel
@{
    ViewData["Title"] = "Conexiones";
}

<section class="dashboard">
    <div class="page-head">
        <div>
            <p class="eyebrow">Mercado, noticias e IA</p>
            <h1>Conexiones</h1>
        </div>
        <form method="get" class="filter-bar connections-filter">
            <label>
                <span>Buscar</span>
                <input asp-for="Buscar" type="search" placeholder="fuente, url o mensaje"/>
            </label>
            <label>
                <span>Estado</span>
                <select asp-for="Estado">
                    <option value="todas">Todas</option>
                    <option value="sanas">Sanas</option>
                    <option value="degradadas">Degradadas</option>
                    <option value="fallidas">Fallidas</option>
                </select>
            </label>
            <label>
                <span>Tipo</span>
                <select asp-for="Tipo">
                    <option value="">Todos</option>
                    @foreach (var kind in Model.AvailableKinds)
                    {
                        <option value="@kind">@kind</option>
                    }
                </select>
            </label>
            <button type="submit">Filtrar</button>
        </form>
    </div>

    <section class="metrics-grid metrics-grid-four" aria-label="Resumen de conexiones">
        <article class="metric">
            <span>Fuentes</span>
            <strong>@Model.Report.SourceHealth.Count</strong>
            <small>registradas por telemetria</small>
        </article>
        <article class="metric">
            <span>Sanas</span>
            <strong>@Model.Report.SourceHealth.Count(row => row.Status == Trading.Monitor.Domain.DataSourceStatus.Healthy)</strong>
            <small>responden correctamente</small>
        </article>
        <article class="metric">
            <span>Degradadas</span>
            <strong>@Model.Report.SourceHealth.Count(row => row.Status == Trading.Monitor.Domain.DataSourceStatus.Degraded)</strong>
            <small>sin datos utiles o parciales</small>
        </article>
        <article class="metric">
            <span>Fallidas</span>
            <strong>@Model.Report.SourceHealth.Count(row => row.Status == Trading.Monitor.Domain.DataSourceStatus.Failed)</strong>
            <small>no detienen el servicio</small>
        </article>
    </section>

    <section class="metrics-grid metrics-grid-four" aria-label="Mapa de fuentes">
        <article class="metric metric-soft">
            <span>Conectadas hoy</span>
            <strong class="gain">@Model.CatalogInUseCount</strong>
            <small>ya participan o están listas</small>
        </article>
        <article class="metric metric-soft">
            <span>Por conectar</span>
            <strong>@Model.CatalogCandidateCount</strong>
            <small>requieren llave, plan o reglas</small>
        </article>
        <article class="metric metric-soft">
            <span>Tipos cubiertos</span>
            <strong>@Model.Catalog.Select(item => item.Group).Distinct().Count()</strong>
            <small>mercado, noticias, macro, IA</small>
        </article>
        <article class="metric metric-soft">
            <span>Modo seguro</span>
            <strong class="gain">Paper</strong>
            <small>sin ordenes reales automaticas</small>
        </article>
    </section>

    @if (Model.ExchangeStatus is not null)
    {
        <details class="report-section fold-panel" open>
            <summary>
                <h2>Exchange</h2>
                <span>@Model.ExchangeStatus.Provider</span>
            </summary>
            <div class="fold-body">
                <div class="exchange-status-grid">
                    <article>
                        <span>API publica</span>
                        <strong class="@(Model.ExchangeStatus.PublicApiHealthy ? "gain" : "loss")">@(Model.ExchangeStatus.PublicApiHealthy ? "OK" : "Falla")</strong>
                    </article>
                    <article>
                        <span>Modo</span>
                        <strong>@Model.ExchangeStatus.Mode</strong>
                    </article>
                    <article>
                        <span>Llaves</span>
                        <strong class="@(Model.ExchangeStatus.ApiKeyConfigured && Model.ExchangeStatus.ApiSecretConfigured ? "gain" : "loss")">
                            @(Model.ExchangeStatus.ApiKeyConfigured && Model.ExchangeStatus.ApiSecretConfigured ? "Configuradas" : "Faltan")
                        </strong>
                    </article>
                    <article>
                        <span>Ordenes reales</span>
                        <strong class="@(Model.ExchangeStatus.LiveTradingAllowed ? "loss" : "gain")">@(Model.ExchangeStatus.LiveTradingAllowed ? "Habilitadas" : "Bloqueadas")</strong>
                    </article>
                    <article>
                        <span>Score mínimo auto</span>
                        <strong>@Model.ExchangeStatus.MinimumScoreToExecute/100</strong>
                    </article>
                    <article>
                        <span>Ganancia neta minima</span>
                        <strong>@Model.ExchangeStatus.MinimumExpectedNetProfitPercentAfterCosts.ToString("N2")%</strong>
                    </article>
                    <article>
                        <span>Capital maximo</span>
                        <strong>@Model.ExchangeStatus.MaxCapitalPerTrade.ToString("C2")</strong>
                    </article>
                    <article>
                        <span>Pérdida 24h máxima</span>
                        <strong>@Model.ExchangeStatus.DailyLossLimit.ToString("C2")</strong>
                    </article>
                    <article>
                        <span>Venta en corto</span>
                        <strong class="@(Model.ExchangeStatus.AllowShortSelling ? "status-open" : "status-muted")">@(Model.ExchangeStatus.AllowShortSelling ? "Permitida" : "Bloqueada")</strong>
                    </article>
                    <article>
                        <span>Simbolos</span>
                        <strong>@string.Join(", ", Model.ExchangeStatus.AllowedSymbols)</strong>
                    </article>
                </div>
                <p class="exchange-status-note">@Model.ExchangeStatus.Message @Model.ExchangeStatus.Safety</p>
            </div>
        </details>
    }

    <details class="report-section fold-panel" open>
        <summary>
            <h2>Ejecucion automatica</h2>
            <span>@Model.RecentExecutions.Count intentos recientes</span>
        </summary>

        <div class="fold-body">
            @if (Model.RecentExecutions.Count == 0)
            {
                <div class="empty-state">
                    <strong>Aún no hay intentos registrados.</strong>
                    <span>Cuando llegue una señal nueva, aquí verás si fue simulada, validada, bloqueada o enviada.</span>
                </div>
            }
            else
            {
                <div class="execution-audit-list" role="list">
                    @foreach (var execution in Model.RecentExecutions)
                    {
                        <details class="execution-audit-row" role="listitem">
                            <summary>
                                <div>
                                    <strong>@execution.Symbol - @Model.ExecutionActionLabel(execution.Action)</strong>
                                    <span>@execution.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm:ss") | @Model.ExecutionModeLabel(execution.Mode)</span>
                                </div>
                                <span class="status @Model.ExecutionStatusClass(execution.Status)">@execution.Status</span>
                            </summary>
                            <div class="execution-audit-detail">
                                <article>
                                    <span>Capital</span>
                                    <strong>@execution.RequestedCapital.ToString("C2")</strong>
                                </article>
                                <article>
                                    <span>Cantidad</span>
                                    <strong>@(execution.ExecutedQuantity?.ToString("N8") ?? execution.RequestedQuantity?.ToString("N8") ?? "-")</strong>
                                </article>
                                <article>
                                    <span>Precio</span>
                                    <strong>@(execution.Price?.ToString("N2") ?? "-")</strong>
                                </article>
                                <article>
                                    <span>Total recibido</span>
                                    <strong>@(execution.ExecutedQuote?.ToString("C2") ?? "-")</strong>
                                </article>
                                <p><strong>@execution.Reason</strong> - @execution.Message</p>
                                @if (!string.IsNullOrWhiteSpace(execution.ExchangeOrderId))
                                {
                                    <small>Orden exchange: @execution.ExchangeOrderId</small>
                                }
                            </div>
                        </details>
                    }
                </div>
            }
        </div>
    </details>

    @if (Model.FilteredSources.Count == 0)
    {
        <div class="empty-state">
            <strong>No hay conexiones para ese filtro.</strong>
            <span>Prueba cambiando estado, tipo o texto de búsqueda.</span>
        </div>
    }
    else
    {
        var sourceGroupIndex = 0;
        @foreach (var group in Model.SourcesByKind)
        {
            var isFirstGroup = sourceGroupIndex++ == 0;
            <details class="report-section fold-panel" open="@isFirstGroup">
                <summary>
                    <h2>@group.Key</h2>
                    <span>@group.Count() fuentes</span>
                </summary>

                <div class="fold-body">
                    <div class="source-grid">
                        @foreach (var source in group)
                        {
                            <article class="source-row">
                                <div>
                                    <strong>@source.SourceName</strong>
                                    <span>@(source.Url ?? "sin URL")</span>
                                </div>
                                <span class="status @Model.SourceStatusClass(source.Status)">@source.Status</span>
                                <div>
                                    <small>Ultimo ok</small>
                                    <strong>@(source.LastSuccessAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "-")</strong>
                                </div>
                                <div>
                                    <small>Fallos</small>
                                    <strong>@source.FailureCount</strong>
                                </div>
                                <p>@source.LastMessage</p>
                            </article>
                        }
                    </div>
                </div>
            </details>
        }
    }

    <details class="report-section fold-panel">
        <summary>
            <h2>Mapa de fuentes</h2>
            <span>conectadas y candidatas</span>
        </summary>

        <div class="fold-body">
            <div class="catalog-grid">
                @foreach (var item in Model.Catalog)
                {
                    <article class="catalog-card">
                        <div>
                            <span>@item.Group</span>
                            <strong>@item.Name</strong>
                        </div>
                        <span class="status @Model.CatalogStatusClass(item.Status)">@item.Status</span>
                        <p>@item.Use</p>
                        <small>@item.Requirement</small>
                        <a href="@item.Url" target="_blank" rel="noopener">Ver fuente</a>
                    </article>
                }
            </div>
        </div>
    </details>

    <details class="report-section fold-panel">
        <summary>
            <h2>Investigacion reciente</h2>
            <span>@Model.Report.RecentResearch.Count items</span>
        </summary>

        <div class="fold-body">
            @if (Model.Report.RecentResearch.Count == 0)
            {
                <div class="empty-state">
                    <strong>Aún no hay investigación capturada.</strong>
                    <span>Las noticias, reportes macro y resumenes de IA apareceran aqui cuando coincidan con los activos monitoreados.</span>
                </div>
            }
            else
            {
                <div class="research-list">
                    @foreach (var item in Model.Report.RecentResearch)
                    {
                        <article class="research-row">
                            <div class="research-meta">
                                <span>@item.PublishedAt.ToLocalTime().ToString("dd MMM HH:mm")</span>
                                <span>@item.Kind</span>
                                <span>@item.Source</span>
                                <span class="@Model.SentimentClass(item.Sentiment)">@item.Sentiment</span>
                            </div>
                            @if (item.Url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="@item.Url" target="_blank" rel="noopener">@item.Title</a>
                            }
                            else
                            {
                                <strong>@item.Title</strong>
                            }
                            <small>@item.Symbols</small>
                        </article>
                    }
                </div>
            }
        </div>
    </details>
</section>
