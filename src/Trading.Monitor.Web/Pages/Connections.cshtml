@page "/conexiones"
@model ConnectionsModel
@{
    ViewData["Title"] = "Conexiones";
}

<section class="dashboard">
    <div class="page-head">
        <div>
            <p class="eyebrow">@Model.ScopeLabel() | mercado, noticias, IA y traders</p>
            <h1>Conexiones</h1>
        </div>
    </div>

    <section class="metrics-grid metrics-grid-four" aria-label="Resumen de conexiones">
        <article class="metric">
            <span>Fuentes visibles</span>
            <strong>@(Model.FilteredSources.Count + Model.FilteredCatalog.Count)</strong>
            <small>@Model.FilteredSources.Count activas, @Model.FilteredCatalog.Count mapeadas</small>
        </article>
        <article class="metric">
            <span>Sanas</span>
            <strong class="gain">@Model.FilteredSources.Count(row => row.Status == Trading.Monitor.Domain.DataSourceStatus.Healthy)</strong>
            <small>responden correctamente</small>
        </article>
        <article class="metric">
            <span>Degradadas</span>
            <strong>@Model.FilteredSources.Count(row => row.Status == Trading.Monitor.Domain.DataSourceStatus.Degraded)</strong>
            <small>datos parciales o sin utilidad</small>
        </article>
        <article class="metric">
            <span>Fallidas</span>
            <strong class="loss">@Model.FilteredSources.Count(row => row.Status == Trading.Monitor.Domain.DataSourceStatus.Failed)</strong>
            <small>no detienen el servicio</small>
        </article>
    </section>

    @if (Model.ExchangeStatus is not null && Model.Ambito != "traders")
    {
        <details class="report-section fold-panel">
            <summary>
                <h2>Exchange automático</h2>
                <span>@Model.ExchangeStatus.Provider | @Model.ExchangeStatus.Mode</span>
            </summary>
            <div class="fold-body">
                <div class="exchange-status-grid">
                    <article><span>API pública</span><strong class="@(Model.ExchangeStatus.PublicApiHealthy ? "gain" : "loss")">@(Model.ExchangeStatus.PublicApiHealthy ? "OK" : "Falla")</strong></article>
                    <article><span>Llaves</span><strong class="@(Model.ExchangeStatus.ApiKeyConfigured && Model.ExchangeStatus.ApiSecretConfigured ? "gain" : "loss")">@(Model.ExchangeStatus.ApiKeyConfigured && Model.ExchangeStatus.ApiSecretConfigured ? "Configuradas" : "Faltan")</strong></article>
                    <article><span>Órdenes reales</span><strong class="@(Model.ExchangeStatus.LiveTradingAllowed ? "loss" : "gain")">@(Model.ExchangeStatus.LiveTradingAllowed ? "Habilitadas" : "Bloqueadas")</strong></article>
                    <article><span>Ganancia neta mínima</span><strong>@Model.ExchangeStatus.MinimumExpectedNetProfitPercentAfterCosts.ToString("N2")%</strong></article>
                    <article><span>Score mínimo auto</span><strong>@Model.ExchangeStatus.MinimumScoreToExecute/100</strong></article>
                    <article><span>Capital máximo</span><strong>@Model.ExchangeStatus.MaxCapitalPerTrade.ToString("C2")</strong></article>
                    <article><span>Pérdida 24h máxima</span><strong>@Model.ExchangeStatus.DailyLossLimit.ToString("C2")</strong></article>
                    <article><span>Símbolos</span><strong>@string.Join(", ", Model.ExchangeStatus.AllowedSymbols)</strong></article>
                </div>
                <p class="exchange-status-note">@Model.ExchangeStatus.Message @Model.ExchangeStatus.Safety</p>
            </div>
        </details>
    }

    <section class="report-section">
        <div class="section-title">
            <h2>Mapa navegable de fuentes</h2>
            <span>elige concepto y luego fuente</span>
        </div>

        @if (Model.ConnectionGroups.Count == 0)
        {
            <div class="empty-state">
                <strong>No hay conexiones para este ámbito.</strong>
                <span>Prueba desde el menú con Crypto, Forex o Traders.</span>
            </div>
        }
        else
        {
            <div class="master-detail connections-workbench" data-master-detail>
                <div class="master-list connection-concept-list" aria-label="Conceptos de conexión">
                    @for (var groupIndex = 0; groupIndex < Model.ConnectionGroups.Count; groupIndex++)
                    {
                        var group = Model.ConnectionGroups[groupIndex];
                        var key = $"concept-{groupIndex}";
                        <button type="button"
                                class="master-item @(groupIndex == 0 ? "active" : "")"
                                data-detail-key="@key"
                                data-filter-text="@($"{group.Name} {Model.ConceptDescription(group.Name)}")"
                                data-filter-status="@(group.Failed > 0 ? "Con fallas" : "Sin fallas")"
                                data-filter-type="@group.Name">
                            <span class="master-kicker">@group.Name</span>
                            <strong>@Model.ConceptDescription(group.Name)</strong>
                            <span class="status @Model.ConceptClass(group.Name)">@group.Total fuentes</span>
                            <div class="master-item-extra">
                                <span>@group.Healthy sanas/en uso</span>
                                <span>@group.Failed fallidas</span>
                            </div>
                        </button>
                    }
                </div>

                <div class="detail-stack">
                    @for (var groupIndex = 0; groupIndex < Model.ConnectionGroups.Count; groupIndex++)
                    {
                        var group = Model.ConnectionGroups[groupIndex];
                        var key = $"concept-{groupIndex}";
                        <article class="detail-panel @(groupIndex == 0 ? "active" : "")" data-detail-panel="@key">
                            <div class="section-title">
                                <h2>@group.Name</h2>
                                <span>@group.Visible de @group.Total fuentes</span>
                            </div>
                            <p class="detail-copy">@Model.ConceptSearchSummary(group.Name)</p>

                            <form method="get" class="connection-filter-card connection-source-filter">
                                <input asp-for="Ambito" type="hidden"/>
                                <label>
                                    <span>Buscar</span>
                                    <input asp-for="Buscar" type="search" placeholder="fuente, url, mensaje o error"/>
                                </label>
                                <label>
                                    <span>Estado</span>
                                    <select asp-for="Estado">
                                        <option value="todas">Todas</option>
                                        <option value="sanas">Sanas</option>
                                        <option value="degradadas">Degradadas</option>
                                        <option value="fallidas">Fallidas</option>
                                    </select>
                                </label>
                                <label>
                                    <span>Tipo técnico</span>
                                    <select asp-for="Tipo">
                                        <option value="">Todos</option>
                                        @foreach (var kind in Model.AvailableKinds)
                                        {
                                            <option value="@kind">@kind</option>
                                        }
                                    </select>
                                </label>
                                <button type="submit">Filtrar fuentes</button>
                            </form>

                            @if (group.Visible == 0)
                            {
                                <div class="empty-state">
                                    <strong>No hay fuentes visibles para este filtro.</strong>
                                    <span>El concepto sigue existiendo; cambia búsqueda, estado o tipo técnico.</span>
                                </div>
                            }
                            else
                            {
                                <div class="master-detail nested-workbench connection-source-workbench" data-master-detail>
                                    <div class="master-list" aria-label="Fuentes de @group.Name">
                                        @{
                                            var localIndex = 0;
                                        }
                                        @foreach (var source in group.Sources)
                                        {
                                            var sourceKey = $"source-{groupIndex}-{localIndex++}";
                                            <button type="button"
                                                    class="master-item @(localIndex == 1 ? "active" : "")"
                                                    data-detail-key="@sourceKey"
                                                    data-filter-text="@($"{source.SourceName} {source.Kind} {source.Status} {source.LastMessage} {source.Url}")"
                                                    data-filter-status="@source.Status"
                                                    data-filter-type="@source.Kind">
                                                <span class="master-kicker">@source.Kind</span>
                                                <strong>@source.SourceName</strong>
                                                <span class="status @Model.SourceStatusClass(source.Status)">@source.Status</span>
                                                <small>@source.LastMessage</small>
                                            </button>
                                        }
                                        @foreach (var item in group.Catalog)
                                        {
                                            var sourceKey = $"catalog-{groupIndex}-{localIndex++}";
                                            <button type="button"
                                                    class="master-item @(localIndex == 1 ? "active" : "")"
                                                    data-detail-key="@sourceKey"
                                                    data-filter-text="@($"{item.Group} {item.Name} {item.Status} {item.Use} {item.Requirement}")"
                                                    data-filter-status="@item.Status"
                                                    data-filter-type="@item.Group">
                                                <span class="master-kicker">@item.Group</span>
                                                <strong>@item.Name</strong>
                                                <span class="status @Model.CatalogStatusClass(item.Status)">@item.Status</span>
                                                <small>@item.Use</small>
                                            </button>
                                        }
                                    </div>

                                    <div class="detail-stack">
                                        @{
                                            localIndex = 0;
                                        }
                                        @foreach (var source in group.Sources)
                                        {
                                            var sourceKey = $"source-{groupIndex}-{localIndex++}";
                                            <article class="detail-panel @(localIndex == 1 ? "active" : "")" data-detail-panel="@sourceKey">
                                                <div class="section-title">
                                                    <h2>@source.SourceName</h2>
                                                    <span>@source.Kind</span>
                                                </div>
                                                <div class="detail-grid">
                                                    <article><span>Estado</span><strong class="@Model.SourceStatusClass(source.Status)">@source.Status</strong><small>telemetría real</small></article>
                                                    <article><span>Último OK</span><strong>@(source.LastSuccessAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "-")</strong><small>última respuesta útil</small></article>
                                                    <article><span>Última falla</span><strong>@(source.LastFailureAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "-")</strong><small>@source.FailureCount fallos</small></article>
                                                    <article><span>URL</span><strong>@(source.Url ?? "sin URL")</strong><small>origen monitoreado</small></article>
                                                </div>
                                                <p class="detail-copy"><strong>Qué busca:</strong> @Model.ConceptSearchSummary(group.Name)</p>
                                                <p class="detail-copy"><strong>Consulta/error:</strong> @Model.SourceQueryDetail(source)</p>
                                                @if (!string.IsNullOrWhiteSpace(source.Url))
                                                {
                                                    <div class="trade-links">
                                                        <a href="@source.Url" target="_blank" rel="noopener">Abrir fuente</a>
                                                    </div>
                                                }
                                            </article>
                                        }
                                        @foreach (var item in group.Catalog)
                                        {
                                            var sourceKey = $"catalog-{groupIndex}-{localIndex++}";
                                            <article class="detail-panel @(localIndex == 1 ? "active" : "")" data-detail-panel="@sourceKey">
                                                <div class="section-title">
                                                    <h2>@item.Name</h2>
                                                    <span>@item.Group</span>
                                                </div>
                                                <div class="detail-grid">
                                                    <article><span>Estado</span><strong class="@Model.CatalogStatusClass(item.Status)">@item.Status</strong><small>mapa de integración</small></article>
                                                    <article><span>Uso</span><strong>@item.Group</strong><small>tipo de información</small></article>
                                                    <article><span>Requisito</span><strong>@item.Requirement</strong><small>llave, plan o regla</small></article>
                                                    <article><span>Alcance</span><strong>@Model.ScopeLabel()</strong><small>filtro actual</small></article>
                                                </div>
                                                <p class="detail-copy"><strong>Qué aporta:</strong> @item.Use</p>
                                                <p class="detail-copy"><strong>Detalle de integración:</strong> @Model.CatalogQueryDetail(item)</p>
                                                <div class="trade-links">
                                                    <a href="@item.Url" target="_blank" rel="noopener">Abrir fuente</a>
                                                </div>
                                            </article>
                                        }
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            </div>
        }
    </section>

    <details class="report-section fold-panel">
        <summary>
            <h2>Ejecución automática</h2>
            <span>@Model.RecentExecutions.Count intentos recientes</span>
        </summary>

        <div class="fold-body">
            @if (Model.RecentExecutions.Count == 0)
            {
                <div class="empty-state">
                    <strong>Aún no hay intentos registrados.</strong>
                    <span>Cuando llegue una señal nueva, aquí verás si fue simulada, validada, bloqueada o enviada.</span>
                </div>
            }
            else
            {
                <div class="execution-audit-list" role="list">
                    @foreach (var execution in Model.RecentExecutions)
                    {
                        <details class="execution-audit-row" role="listitem">
                            <summary>
                                <div>
                                    <strong>@execution.Symbol - @Model.ExecutionActionLabel(execution.Action)</strong>
                                    <span>@execution.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm:ss") | @Model.ExecutionModeLabel(execution.Mode)</span>
                                </div>
                                <span class="status @Model.ExecutionStatusClass(execution.Status)">@execution.Status</span>
                            </summary>
                            <div class="execution-audit-detail">
                                <article><span>Capital</span><strong>@execution.RequestedCapital.ToString("C2")</strong></article>
                                <article><span>Cantidad</span><strong>@(execution.ExecutedQuantity?.ToString("N8") ?? execution.RequestedQuantity?.ToString("N8") ?? "-")</strong></article>
                                <article><span>Precio</span><strong>@(execution.Price?.ToString("N2") ?? "-")</strong></article>
                                <article><span>Total recibido</span><strong>@(execution.ExecutedQuote?.ToString("C2") ?? "-")</strong></article>
                                <p><strong>@execution.Reason</strong> - @execution.Message</p>
                                @if (!string.IsNullOrWhiteSpace(execution.ExchangeOrderId))
                                {
                                    <small>Orden exchange: @execution.ExchangeOrderId</small>
                                }
                            </div>
                        </details>
                    }
                </div>
            }
        </div>
    </details>

    <details class="report-section fold-panel">
        <summary>
            <h2>Investigación reciente</h2>
            <span>@Model.Report.RecentResearch.Count items</span>
        </summary>

        <div class="fold-body">
            @if (Model.Report.RecentResearch.Count == 0)
            {
                <div class="empty-state">
                    <strong>Aún no hay investigación capturada.</strong>
                    <span>Las noticias, reportes macro y resúmenes de IA aparecerán aquí cuando coincidan con los activos monitoreados.</span>
                </div>
            }
            else
            {
                <div class="research-list">
                    @foreach (var item in Model.Report.RecentResearch)
                    {
                        <article class="research-row">
                            <div class="research-meta">
                                <span>@item.PublishedAt.ToLocalTime().ToString("dd MMM HH:mm")</span>
                                <span>@item.Kind</span>
                                <span>@item.Source</span>
                                <span class="@Model.SentimentClass(item.Sentiment)">@item.Sentiment</span>
                            </div>
                            @if (item.Url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="@item.Url" target="_blank" rel="noopener">@item.Title</a>
                            }
                            else
                            {
                                <strong>@item.Title</strong>
                            }
                            <small>@item.Symbols</small>
                        </article>
                    }
                </div>
            }
        </div>
    </details>
</section>

@section Scripts {
    <script src="~/js/master-detail.js" asp-append-version="true"></script>
}
