@page "/acciones"
@model ActionsModel
@{
    ViewData["Title"] = "Señales fijas";
}

<section class="dashboard">
    <div class="page-head">
        <div>
            <p class="eyebrow">@Model.MarketLabel() | entrada y salida fija</p>
            <h1>Señales fijas</h1>
        </div>
    </div>

    <section class="metrics-grid metrics-grid-four" aria-label="Resumen de señales fijas">
        <article class="metric">
            <span>Saldo simulado</span>
            <strong class="@Model.SignedClass(Model.FilteredRealizedNet)">@Model.Money(Model.SimulatedBalanceAfterClosedOperations)</strong>
            <small>capital + cierres fijos</small>
        </article>
        <article class="metric">
            <span>Ganado</span>
            <strong class="gain">@Model.Money(Model.FilteredWonAmount)</strong>
            <small>después de comisiones</small>
        </article>
        <article class="metric">
            <span>Perdido</span>
            <strong class="loss">@Model.Money(Model.FilteredLostAmount)</strong>
            <small>después de comisiones</small>
        </article>
        <article class="metric">
            <span>Resultado neto</span>
            <strong class="@Model.SignedClass(Model.FilteredRealizedNet)">@Model.Money(Model.FilteredRealizedNet)</strong>
            <small>@Model.FilteredClosedOperations cierres fijos medidos</small>
        </article>
    </section>

    <div class="insight-strip trade-type-guide">
        <span>Señal fija</span>
        <strong>Cada señal trae entrada, mercado objetivo y salida. ★ marca prioridad dentro de la lista; para señales sin salida fija usa <a asp-page="/ManagedPositions" asp-route-Mercado="@Model.MarketRouteValue()">Seguimiento por señal</a>.</strong>
    </div>

    <section class="report-section live-board" data-live-mode="classic" data-live-market="@Model.MarketRouteValue()" data-live-capital="@Model.Report.Capital" data-live-estado="abiertas" data-live-symbol="@Model.Symbol" data-live-tipo-senal="@Model.TipoSenal" data-live-fee-percent="@Model.EstimatedFeePercentPerSide">
        <div class="section-title">
            <h2>Gráfico y señales abiertas</h2>
            <span id="liveUpdated">actualizando...</span>
        </div>
        <form method="get" class="filter-bar live-inline-filter" id="actionsFilterForm" data-auto-submit>
            <input asp-for="Mercado" type="hidden"/>
            <label>
                <span>Monto</span>
                <input asp-for="Capital" type="number" min="0.01" step="0.01"/>
            </label>
            <label>
                <span>Tipo de señal</span>
                <select asp-for="TipoSenal">
                    <option value="">Ambas</option>
                    <option value="@Model.BuyLowSellHighValue">Compra bajo - vende alto</option>
                    <option value="@Model.SellHighBuyLowValue">Vende alto - compra bajo</option>
                </select>
            </label>
            <span class="filter-auto-state" data-auto-submit-state>Filtro automático</span>
            <noscript><button type="submit">Aplicar</button></noscript>
        </form>
        <div class="chart-toolbar" aria-label="Controles del gráfico">
            <div>
                <span>Activo</span>
                @foreach (var symbol in Model.Symbols)
                {
                    <button type="button" data-chart-symbol-button="@symbol">@Model.SymbolButtonLabel(symbol) (@Model.OpenCountFor(symbol))</button>
                }
            </div>
            <div>
                <span>Tiempo</span>
                <button type="button" data-chart-interval="1s">1s</button>
                <button type="button" data-chart-interval="1m" class="active">1m</button>
                <button type="button" data-chart-interval="15m">15m</button>
                <button type="button" data-chart-interval="1h">1h</button>
                <button type="button" data-chart-interval="1d">1d</button>
                <button type="button" data-chart-interval="1w">1w</button>
                <button type="button" data-chart-interval="1M">1M</button>
            </div>
            <div class="chart-zoom-control">
                <span>Zoom</span>
                <button type="button" data-chart-zoom-out>-</button>
                <input id="chartZoom" type="range" min="0" max="100" value="45" aria-label="Zoom del gráfico"/>
                <button type="button" data-chart-zoom-in>+</button>
                <strong id="chartZoomLabel">medio</strong>
            </div>
            <div>
                <button type="button" data-chart-live>Vivo</button>
            </div>
        </div>
        <div id="chartAnalysis" class="chart-analysis">
            <strong>Calculando lectura...</strong>
            <span>El tablero se actualiza solo.</span>
        </div>
        <div class="live-layout">
            <div class="trade-terminal">
                <div class="terminal-strip" id="terminalStrip">
                    <strong>@(Model.SymbolButtonLabel(Model.Symbols.FirstOrDefault() ?? "BTCUSDT"))</strong>
                    <span>cargando mercado...</span>
                </div>
                <div id="advancedTradesChart" class="tradingview-chart" aria-label="Gráfico de señales fijas"></div>
                <div id="chartHoverInfo" class="chart-hover-card" hidden></div>
            </div>
            <div id="liveTradeCards" class="live-trade-list">
                <div class="empty-state">
                    <strong>Cargando señales fijas...</strong>
                    <span>El tablero se refresca solo.</span>
                </div>
            </div>
        </div>
    </section>
</section>

@section Scripts {
    <script src="~/lib/lightweight-charts/dist/lightweight-charts.standalone.production.js"></script>
    <script src="~/js/trading-chart.js" asp-append-version="true"></script>
}
