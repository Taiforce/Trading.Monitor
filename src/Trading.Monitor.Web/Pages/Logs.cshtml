@page "/logs"
@model LogsModel
@{
    ViewData["Title"] = "Logs";
}

<section class="dashboard">
    <div class="page-head">
        <div>
            <p class="eyebrow">Serilog</p>
            <h1>Logs operativos</h1>
        </div>
        <form method="get" class="filter-bar logs-filter">
            <label>
                <span>Archivo</span>
                <select asp-for="LogFile">
                    @foreach (var file in Model.Files)
                    {
                        <option value="@file.RelativePath" selected="@(file.RelativePath == Model.LogFile)">@file.DisplayName</option>
                    }
                </select>
            </label>
            <label>
                <span>Lineas</span>
                <input asp-for="Lines" type="number" min="50" max="1000" step="50"/>
            </label>
            <label>
                <span>Nivel</span>
                <select asp-for="Nivel">
                    <option value="">Todos</option>
                    @foreach (var level in Model.AvailableLevels)
                    {
                        <option value="@level">@level</option>
                    }
                </select>
            </label>
            <label>
                <span>Evento</span>
                <select asp-for="Evento">
                    <option value="">Todos</option>
                    @foreach (var eventType in Model.AvailableEvents)
                    {
                        <option value="@eventType">@eventType</option>
                    }
                </select>
            </label>
            <label>
                <span>Buscar</span>
                <input asp-for="Buscar" type="search" placeholder="senal, error, binance"/>
            </label>
            <button type="submit">Filtrar</button>
        </form>
    </div>

    <section class="metrics-grid metrics-grid-four" aria-label="Resumen de logs">
        <article class="metric">
            <span>Archivos</span>
            <strong>@Model.Files.Count</strong>
            <small>@Model.Snapshot.RootPath</small>
        </article>
        <article class="metric">
            <span>Archivo activo</span>
            <strong>@(Model.Snapshot.File?.DisplayName ?? "-")</strong>
            <small>@(Model.Snapshot.File is null ? "sin seleccion" : Model.SizeLabel(Model.Snapshot.File.SizeBytes))</small>
        </article>
        <article class="metric">
            <span>Ultima escritura</span>
            <strong>@(Model.Snapshot.File?.LastWriteTime.ToLocalTime().ToString("HH:mm") ?? "-")</strong>
            <small>@(Model.Snapshot.File?.LastWriteTime.ToLocalTime().ToString("dd MMM yyyy") ?? "-")</small>
        </article>
        <article class="metric">
            <span>Eventos vistos</span>
            <strong>@Model.FilteredEntries.Count</strong>
            <small>despues de filtros</small>
        </article>
    </section>

    <section class="metrics-grid metrics-grid-four" aria-label="Resumen interpretado de logs">
        <article class="metric metric-soft">
            <span>Errores</span>
            <strong class="@(Model.ErrorCount > 0 ? "loss" : "gain")">@Model.ErrorCount</strong>
            <small>criticos o fallidos</small>
        </article>
        <article class="metric metric-soft">
            <span>Alertas</span>
            <strong class="@(Model.WarningCount > 0 ? "loss" : "gain")">@Model.WarningCount</strong>
            <small>avisos sin detener servicio</small>
        </article>
        <article class="metric metric-soft">
            <span>Senales</span>
            <strong>@Model.SignalCount</strong>
            <small>entradas/salidas detectadas</small>
        </article>
        <article class="metric metric-soft">
            <span>Barridos</span>
            <strong>@Model.ScanCount</strong>
            <small>lecturas de mercado</small>
        </article>
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Actividad por hora</h2>
            <span>@(Model.Snapshot.File?.DisplayName ?? "sin archivo")</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Snapshot.ErrorMessage))
        {
            <div class="empty-state">
                <strong>No pude leer los logs.</strong>
                <span>@Model.Snapshot.ErrorMessage</span>
            </div>
        }
        else if (Model.FilteredEntries.Count == 0)
        {
            <div class="empty-state">
                <strong>Sin eventos para mostrar.</strong>
                <span>Prueba quitando filtros o aumentando el numero de lineas.</span>
            </div>
        }
        else
        {
            <div class="log-chart">
                @foreach (var bucket in Model.Buckets)
                {
                    <article>
                        <span>@bucket.Hour:00</span>
                        <div>
                            <i style="width:@Model.BarWidth(bucket.Count)%"></i>
                        </div>
                        <strong>@bucket.Count</strong>
                    </article>
                }
            </div>
        }
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Eventos interpretados</h2>
            <span>@Model.FilteredEntries.Count eventos</span>
        </div>

        @if (Model.FilteredEntries.Count == 0)
        {
            <div class="empty-state">
                <strong>No hay eventos para ese filtro.</strong>
                <span>Prueba con otro nivel, evento o busqueda.</span>
            </div>
        }
        else
        {
            <div class="log-event-list">
                @foreach (var entry in Model.FilteredEntries.Take(120))
                {
                    <article class="log-event-row">
                        <div>
                            <strong>@entry.Time</strong>
                            <span>@entry.Service</span>
                        </div>
                        <span class="status @Model.LevelClass(entry.Level)">@entry.LevelLabel</span>
                        <span class="@Model.EventClass(entry.EventType)">@entry.EventType</span>
                        <p>@entry.Message</p>
                    </article>
                }
            </div>
        }
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Texto crudo</h2>
            <span>auditoria</span>
        </div>

        @if (Model.Snapshot.Lines.Count == 0)
        {
            <div class="empty-state">
                <strong>Sin lineas para mostrar.</strong>
                <span>Cuando web o worker escriban logs, apareceran aqui.</span>
            </div>
        }
        else
        {
            <details class="compact-details">
                <summary>Ver lineas originales</summary>
                <pre class="log-output">@foreach (var line in Model.Snapshot.Lines)
{
@line
}</pre>
            </details>
        }
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Archivos disponibles</h2>
            <span>@Model.Files.Count encontrados</span>
        </div>

        <div class="log-file-list">
            @foreach (var file in Model.Files)
            {
                <a asp-page="/Logs" asp-route-LogFile="@file.RelativePath" asp-route-Lines="@Model.Lines" class="log-file-link">
                    <strong>@file.DisplayName</strong>
                    <span>@Model.SizeLabel(file.SizeBytes)</span>
                    <span>@file.LastWriteTime.ToLocalTime().ToString("dd MMM HH:mm")</span>
                </a>
            }
        </div>
    </section>
</section>
