@page "/logs"
@model LogsModel
@using System.Text.Json
@{
    ViewData["Title"] = "Logs";
    var firstEntry = Model.FilteredEntries.FirstOrDefault();
    var scopeLabel = Model.Ambito switch
    {
        "crypto" => "Crypto",
        "forex" => "Forex",
        "traders" => "Traders",
        _ => "Todo"
    };
}

<section class="dashboard">
    <div class="page-head">
        <div>
            <p class="eyebrow"><span class="scope-dot scope-@Model.Ambito"></span>@scopeLabel | Serilog</p>
            <h1>Logs operativos</h1>
            <p class="page-intro">Solo se muestran eventos clasificados como @scopeLabel. Los filtros se aplican al escribir, sin recargar la página.</p>
        </div>
    </div>

    <section class="metrics-grid metrics-grid-four" aria-label="Resumen de logs">
        <article class="metric">
            <span>Archivo activo</span>
            <strong id="logMetricFile">@(Model.Snapshot.File?.DisplayName ?? "-")</strong>
            <small id="logMetricRoot">@Model.Snapshot.RootPath</small>
        </article>
        <article class="metric">
            <span>Eventos visibles</span>
            <strong id="logMetricEvents">@Model.FilteredEntries.Count</strong>
            <small>después de filtros</small>
        </article>
        <article class="metric">
            <span>Errores / alertas</span>
            <strong id="logMetricWarnings" class="@(Model.ErrorCount > 0 ? "loss" : "gain")">@Model.ErrorCount / @Model.WarningCount</strong>
            <small>críticos y avisos</small>
        </article>
        <article class="metric">
            <span>Señales / barridos</span>
            <strong id="logMetricSignals">@Model.SignalCount / @Model.ScanCount</strong>
            <small>actividad del monitor</small>
        </article>
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Explorador de logs</h2>
            <span id="logActiveFile">@(Model.Snapshot.File?.DisplayName ?? "sin archivo")</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Snapshot.ErrorMessage))
        {
            <div class="empty-state">
                <strong>No pude leer los logs.</strong>
                <span>@Model.Snapshot.ErrorMessage</span>
            </div>
        }

        <div class="logs-explorer"
             data-log-explorer
             data-log-file="@Model.LogFile"
             data-log-lines="@Model.Lines"
             data-log-scope="@Model.Ambito">
            <aside class="logs-sidebar">
                <form method="get" class="connection-filter-card logs-filter-panel" data-log-filter aria-label="Filtros de logs">
                    <input asp-for="Ambito" type="hidden" data-log-scope-input/>
                    <div class="filter-panel-head">
                        <div>
                            <span>Vista activa</span>
                            <strong>@scopeLabel</strong>
                        </div>
                        <span class="live-filter-state" data-log-loading aria-live="polite">Actualización automática</span>
                    </div>
                    <div class="logs-filter-grid">
                        <label class="filter-search-wide">
                            <span>Buscar dentro de @scopeLabel</span>
                            <input asp-for="Buscar" type="search" placeholder="símbolo, proveedor o mensaje" autocomplete="off" data-log-search/>
                        </label>
                        <label>
                            <span>Nivel</span>
                            <select asp-for="Nivel" data-log-level>
                                <option value="">Todos</option>
                                @foreach (var level in Model.AvailableLevels)
                                {
                                    <option value="@level">@level</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Evento</span>
                            <select asp-for="Evento" data-log-event>
                                <option value="">Todos</option>
                                @foreach (var eventType in Model.AvailableEvents)
                                {
                                    <option value="@eventType">@eventType</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Profundidad</span>
                            <select asp-for="Lines" data-log-lines-input>
                                <option value="100">100 líneas</option>
                                <option value="250">250 líneas</option>
                                <option value="500">500 líneas</option>
                                <option value="1000">1,000 líneas</option>
                            </select>
                        </label>
                    </div>
                </form>

                <div class="section-title compact-title">
                    <h2>Archivos</h2>
                    <span id="logFileCount">@Model.Files.Count</span>
                </div>
                <div class="log-file-list interactive-log-file-list" id="logFileList">
                    @foreach (var file in Model.Files)
                    {
                        <button type="button"
                                class="log-file-link @(file.RelativePath == Model.LogFile ? "active" : "")"
                                data-log-file="@file.RelativePath">
                            <strong>@file.DisplayName</strong>
                            <span>@Model.SizeLabel(file.SizeBytes)</span>
                            <span>@file.LastWriteTime.ToLocalTime().ToString("dd MMM HH:mm")</span>
                        </button>
                    }
                </div>
            </aside>

            <section class="logs-events-panel">
                <div class="section-title compact-title">
                    <h2>Actividad por hora</h2>
                    <span>archivo seleccionado</span>
                </div>
                <div class="log-chart" id="logBucketChart">
                    @foreach (var bucket in Model.Buckets)
                    {
                        <article>
                            <span>@bucket.Hour:00</span>
                            <div><i style="width:@Model.BarWidth(bucket.Count)%"></i></div>
                            <strong>@bucket.Count</strong>
                        </article>
                    }
                </div>

                <div class="section-title compact-title">
                    <h2>Eventos</h2>
                    <span id="logEventCount">@Model.FilteredEntries.Count</span>
                </div>
                <div class="master-list logs-event-list" id="logEventList" aria-label="Eventos de log">
                    @if (Model.FilteredEntries.Count == 0)
                    {
                        <div class="empty-state">
                            <strong>No hay eventos para ese filtro.</strong>
                            <span>Prueba con otro nivel, evento o búsqueda.</span>
                        </div>
                    }
                    else
                    {
                        @for (var index = 0; index < Model.FilteredEntries.Count; index++)
                        {
                            var entry = Model.FilteredEntries[index];
                            <button type="button"
                                    class="master-item @(index == 0 ? "active" : "")"
                                    data-log-entry-index="@index">
                                <span class="master-kicker">@entry.Time | @entry.Service | @scopeLabel</span>
                                <strong>@entry.EventType</strong>
                                <span class="status @Model.LevelClass(entry.Level)">@entry.LevelLabel</span>
                                <small>@entry.Message</small>
                            </button>
                        }
                    }
                </div>
            </section>

            <aside class="logs-detail-panel" id="logDetailPanel">
                @if (firstEntry is null)
                {
                    <div class="empty-state">
                        <strong>Selecciona un evento.</strong>
                        <span>Aquí aparecerá el detalle interpretado del log.</span>
                    </div>
                }
                else
                {
                    <div class="section-title">
                        <h2>@firstEntry.EventType</h2>
                        <span>@firstEntry.Time | @firstEntry.Service</span>
                    </div>
                    <div class="detail-grid">
                        <article><span>Nivel</span><strong class="@Model.EventClass(firstEntry.EventType)">@firstEntry.LevelLabel</strong><small>@firstEntry.Level</small></article>
                        <article><span>Servicio</span><strong>@firstEntry.Service</strong><small>@(Model.Snapshot.File?.DisplayName ?? "-")</small></article>
                        <article><span>Hora</span><strong>@firstEntry.Time</strong><small>bucket @firstEntry.Hour:00</small></article>
                        <article><span>Tipo</span><strong>@firstEntry.EventType</strong><small>interpretado</small></article>
                        <article><span>Ámbito</span><strong>@scopeLabel</strong><small>clasificación estricta</small></article>
                    </div>
                    <p class="detail-copy">@firstEntry.Message</p>
                    <details class="compact-details">
                        <summary>Ver línea cruda</summary>
                        <pre class="log-output compact-log-output">@firstEntry.RawLine</pre>
                    </details>
                }
            </aside>
        </div>
    </section>
</section>

<script type="application/json" id="logInitialEntries">@Html.Raw(JsonSerializer.Serialize(Model.FilteredEntries, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>

@section Scripts {
    <script src="~/js/logs-explorer.js" asp-append-version="true"></script>
}
