@page "/traders"
@model TradersModel
@{
    ViewData["Title"] = "Traders";
}

<section class="dashboard">
    <div class="page-head">
        <div>
            <p class="eyebrow">Copy trading y traders publicos</p>
            <h1>Traders a seguir</h1>
        </div>
        <form method="get" class="filter-bar traders-filter">
            <label>
                <span>Fuente</span>
                <select asp-for="Platform">
                    <option value="">Todas</option>
                    @foreach (var platform in Model.Platforms)
                    {
                        <option value="@platform">@platform</option>
                    }
                </select>
            </label>
            <label>
                <span>Buscar</span>
                <input asp-for="Search" type="search" placeholder="Nombre, mercado, estilo"/>
            </label>
            <label>
                <span>Trades</span>
                <select asp-for="TradeStatus">
                    <option value="todas">Todos</option>
                    <option value="abierta">Abiertos</option>
                    <option value="cerrada">Cerrados</option>
                </select>
            </label>
            <label class="check-filter">
                <input asp-for="OnlyWithHistory" type="checkbox"/>
                <span>Solo con historial</span>
            </label>
            <button type="submit">Filtrar</button>
        </form>
    </div>

    <div class="insight-strip">
        <span>Lectura honesta</span>
        <strong>Esta vista estudia traders y fuentes de copy trading. No copia dinero real: mide historial, riesgo, comisiones y si el historial es verificable antes de pensar en seguir a alguien.</strong>
    </div>

    <section class="metrics-grid metrics-grid-four" aria-label="Resumen traders">
        <article class="metric">
            <span>Fuentes mapeadas</span>
            <strong>@Model.Report.TotalSources</strong>
            <small>copy/social trading</small>
        </article>
        <article class="metric">
            <span>Traders vigilados</span>
            <strong>@Model.Report.TotalTraders</strong>
            <small>@Model.Report.TradersWithHistory con historial local</small>
        </article>
        <article class="metric">
            <span>Trades abiertos</span>
            <strong>@Model.Report.OpenTrades</strong>
            <small>@Model.SelectedTraderName()</small>
        </article>
        <article class="metric">
            <span>Trades cerrados</span>
            <strong>@Model.Report.ClosedTrades</strong>
            <small>base para simular</small>
        </article>
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Fuentes donde seguir traders</h2>
            <span>catalogo investigado</span>
        </div>
        <div class="master-detail compact-workbench" data-master-detail>
            <div class="master-list" aria-label="Fuentes de traders">
                @for (var index = 0; index < Model.Report.Sources.Count; index++)
                {
                    var source = Model.Report.Sources[index];
                    var key = $"source-{index}";
                    <button type="button" class="master-item @(index == 0 ? "active" : "")" data-detail-key="@key">
                        <span class="master-kicker">@source.Platform</span>
                        <strong>@source.Name</strong>
                        <small>@source.Market</small>
                        <div class="master-item-extra">
                            <span>@(source.SupportsCopyTrading ? "Copy trading disponible" : "Solo investigacion")</span>
                        </div>
                    </button>
                }
            </div>
            <div class="detail-stack">
                @for (var index = 0; index < Model.Report.Sources.Count; index++)
                {
                    var source = Model.Report.Sources[index];
                    var key = $"source-{index}";
                    <article class="detail-panel @(index == 0 ? "active" : "")" data-detail-panel="@key">
                        <div class="section-title">
                            <h2>@source.Name</h2>
                            <span>@source.Platform</span>
                        </div>
                        <div class="detail-grid">
                            <article><span>Mercado</span><strong>@source.Market</strong><small>universo principal</small></article>
                            <article><span>Acceso</span><strong>@source.DataAccess</strong><small>como se obtiene informacion</small></article>
                            <article><span>Calidad</span><strong>@source.DataQuality</strong><small>que tan verificable es</small></article>
                            <article><span>Copy trading</span><strong>@(source.SupportsCopyTrading ? "Si" : "No")</strong><small>requiere revisar comisiones y riesgo</small></article>
                        </div>
                        <p class="detail-copy">@source.Notes</p>
                        <div class="trade-links">
                            <a href="@source.Url" target="_blank" rel="noopener noreferrer">Abrir fuente</a>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Traders y rankings</h2>
            <span>clic para ver historial</span>
        </div>
        @if (Model.Report.Traders.Count == 0)
        {
            <div class="empty-state">
                <strong>No encontre traders con esos filtros.</strong>
                <span>Quita filtros o busca por otra fuente.</span>
            </div>
        }
        else
        {
            <div class="master-detail trader-workbench" data-master-detail>
                <div class="master-list" aria-label="Traders y rankings">
                    @for (var index = 0; index < Model.Report.Traders.Count; index++)
                    {
                        var trader = Model.Report.Traders[index];
                        var key = $"trader-{trader.Id}";
                        var isSelected = Model.TraderId == trader.Id || (!Model.TraderId.HasValue && index == 0);
                        <button type="button" class="master-item @(isSelected ? "active" : "")" data-detail-key="@key">
                            <span class="master-kicker">@trader.Platform | fiabilidad @trader.ReliabilityScore.ToString("N0")</span>
                            <strong>@trader.DisplayName</strong>
                            <small>@trader.StrategyType | @trader.Market</small>
                            <span class="@Model.SignedClass(trader.RealizedNetPnL)">Neto local @Model.Money(trader.RealizedNetPnL)</span>
                            <div class="master-item-extra">
                                <span>@trader.TrackedTrades trades</span>
                                <span>Win rate @(trader.WinRatePercent.HasValue ? $"{trader.WinRatePercent:N2}%" : "-")</span>
                            </div>
                        </button>
                    }
                </div>
                <div class="detail-stack">
                    @for (var index = 0; index < Model.Report.Traders.Count; index++)
                    {
                        var trader = Model.Report.Traders[index];
                        var key = $"trader-{trader.Id}";
                        var isSelected = Model.TraderId == trader.Id || (!Model.TraderId.HasValue && index == 0);
                        <article class="detail-panel @(isSelected ? "active" : "")" data-detail-panel="@key">
                            <div class="section-title">
                                <h2>@trader.DisplayName</h2>
                                <span>@trader.Platform | @trader.Market</span>
                            </div>
                            <div class="trader-detail-head">
                                <div class="score-ring @Model.ReliabilityClass(trader.ReliabilityScore)">
                                    <strong>@trader.ReliabilityScore.ToString("N0")</strong>
                                    <small>fiabilidad</small>
                                </div>
                                <p>@trader.PerformanceText</p>
                            </div>
                            <div class="detail-grid">
                                <article><span>Popularidad</span><strong>@trader.PopularityText</strong><small>senal social</small></article>
                                <article><span>Historial local</span><strong>@trader.TrackedTrades trades</strong><small>@trader.OpenTrades abiertos, @trader.ClosedTrades cerrados</small></article>
                                <article><span>Win rate local</span><strong>@(trader.WinRatePercent.HasValue ? $"{trader.WinRatePercent:N2}%" : "-")</strong><small>solo trades importados</small></article>
                                <article><span>Neto local</span><strong class="@Model.SignedClass(trader.RealizedNetPnL)">@Model.Money(trader.RealizedNetPnL)</strong><small>resultado medido</small></article>
                                <article><span>Datos</span><strong>@trader.DataAvailability</strong><small>transparencia</small></article>
                                <article><span>Ultima lectura</span><strong>@(trader.LastSyncedAt.HasValue ? trader.LastSyncedAt.Value.ToLocalTime().ToString("dd MMM HH:mm") : "-")</strong><small>sincronizacion</small></article>
                            </div>
                            <p class="detail-copy">@trader.Notes</p>
                            <div class="trade-links">
                                <a asp-page="/Traders"
                                   asp-route-Platform="@Model.Platform"
                                   asp-route-Search="@Model.Search"
                                   asp-route-TradeStatus="@Model.TradeStatus"
                                   asp-route-OnlyWithHistory="@Model.OnlyWithHistory"
                                   asp-route-TraderId="@trader.Id">Ver historial</a>
                                <a href="@trader.ProfileUrl" target="_blank" rel="noopener noreferrer">Perfil</a>
                                <a asp-page="/Portfolio" asp-route-TraderId="@trader.Id">Simular cartera</a>
                            </div>
                        </article>
                    }
                </div>
            </div>
        }
    </section>

    <section class="report-section">
        <div class="section-title">
            <h2>Historial de trades</h2>
            <span>@Model.SelectedTraderName()</span>
        </div>
        @if (Model.Report.Trades.Count == 0)
        {
            <div class="empty-state">
                <strong>Sin operaciones importadas o conectadas.</strong>
                <span>El perfil existe, pero la fuente no expone aqui su historial completo de forma publica. Cuando haya trades reales, esta tabla mostrara abiertos, cerrados, entrada, salida y resultado.</span>
            </div>
        }
        else
        {
            <div class="master-detail trader-workbench" data-master-detail>
                <div class="master-list" aria-label="Historial de trades">
                    @for (var index = 0; index < Model.Report.Trades.Count; index++)
                    {
                        var trade = Model.Report.Trades[index];
                        <button type="button" class="master-item @(index == 0 ? "active" : "")" data-detail-key="@trade.Id">
                            <span class="master-kicker">@trade.TraderName | @trade.OpenedAt.ToLocalTime().ToString("dd MMM HH:mm")</span>
                            <strong>@trade.Symbol - @trade.SignalType</strong>
                            <span class="status @Model.TradeStatusClass(trade.Status)">@trade.Status</span>
                            <small class="@Model.SignedClass(trade.NetPnL ?? trade.PnLPercent)">Resultado @Model.Money(trade.NetPnL)</small>
                            <div class="master-item-extra">
                                <span>Entrada @Model.Price(trade.EntryPrice)</span>
                                <span>Salida @Model.Price(trade.ExitPrice)</span>
                            </div>
                        </button>
                    }
                </div>
                <div class="detail-stack">
                    @for (var index = 0; index < Model.Report.Trades.Count; index++)
                    {
                        var trade = Model.Report.Trades[index];
                        <article class="detail-panel @(index == 0 ? "active" : "")" data-detail-panel="@trade.Id">
                            <div class="section-title">
                                <h2>@trade.Symbol - @trade.SignalType</h2>
                                <span>@trade.TraderName | @trade.Status</span>
                            </div>
                            <div class="detail-grid">
                                <article><span>Trader</span><strong>@trade.TraderName</strong><small>@trade.Platform</small></article>
                                <article><span>Entrada</span><strong>@trade.OpenedAt.ToLocalTime().ToString("dd MMM HH:mm")</strong><small>@Model.Price(trade.EntryPrice)</small></article>
                                <article><span>Salida</span><strong>@(trade.ClosedAt.HasValue ? trade.ClosedAt.Value.ToLocalTime().ToString("dd MMM HH:mm") : "-")</strong><small>@Model.Price(trade.ExitPrice)</small></article>
                                <article><span>Cantidad</span><strong>@(trade.Quantity.HasValue ? $"{trade.Quantity:N8}" : "-")</strong><small>unidades</small></article>
                                <article><span>Resultado</span><strong class="@Model.SignedClass(trade.NetPnL ?? trade.PnLPercent)">@Model.Money(trade.NetPnL)</strong><small>@(trade.PnLPercent.HasValue ? $"{trade.PnLPercent:N2}%" : "-")</small></article>
                                <article><span>Apalancamiento</span><strong>@(trade.Leverage.HasValue ? $"{trade.Leverage:N2}x" : "-")</strong><small>riesgo</small></article>
                            </div>
                            <p class="detail-copy">@trade.Notes</p>
                            @if (!string.IsNullOrWhiteSpace(trade.SourceUrl))
                            {
                                <div class="trade-links">
                                    <a href="@trade.SourceUrl" target="_blank" rel="noopener noreferrer">Abrir fuente</a>
                                </div>
                            }
                        </article>
                    }
                </div>
            </div>
        }
    </section>
</section>

@section Scripts {
    <script src="~/js/master-detail.js" asp-append-version="true"></script>
}
