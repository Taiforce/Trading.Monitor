{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "TradingMonitor": {
    "Enabled": true,
    "Symbols": [ "BTCUSDT", "ETHUSDT" ],
    "Intervals": [ "1m", "5m", "15m", "1h", "4h" ],
    "TriggerInterval": "5m",
    "CandleLimit": 250,
    "MinimumScore": 80,
    "EvaluationIntervalSeconds": 60,
    "DuplicateWindowMinutes": 20,
    "SignalExpiryMinutes": 8,
    "RunOnce": false
  },
  "Risk": {
    "EntryAtrBuffer": 0.2,
    "AtrStopMultiplier": 1.5,
    "Target1R": 2.0,
    "Target2R": 3.0,
    "MinimumRiskReward": 2.0,
    "MinimumAtrPercent": 0.05,
    "MaximumAtrPercent": 8.0
  },
  "MarketSources": {
    "BinanceEnabled": true,
    "BinanceUsEnabled": true,
    "CoinbaseEnabled": true,
    "KrakenEnabled": true,
    "BinanceBaseUrl": "https://api.binance.com",
    "BinanceUsBaseUrl": "https://api.binance.us",
    "CoinbaseBaseUrl": "https://api.exchange.coinbase.com",
    "KrakenBaseUrl": "https://api.kraken.com",
    "TimeoutSeconds": 10
  },
  "News": {
    "Enabled": true,
    "TimeoutSeconds": 10,
    "MaxNewsAgeHours": 18,
    "Feeds": [
      "https://www.coindesk.com/arc/outboundfeeds/rss/",
      "https://cointelegraph.com/rss",
      "https://decrypt.co/feed",
      "https://news.bitcoin.com/feed/",
      "https://beincrypto.com/feed/",
      "https://cryptobriefing.com/feed/",
      "https://blog.kraken.com/feed",
      "https://www.federalreserve.gov/feeds/press_all.xml",
      "https://www.sec.gov/news/pressreleases.rss"
    ],
    "SymbolKeywords": {
      "BTCUSDT": [ "BTC", "Bitcoin" ],
      "ETHUSDT": [ "ETH", "Ethereum" ]
    }
  },
  "OpenAi": {
    "Enabled": true,
    "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
    "BaseUrl": "https://api.openai.com",
    "Model": "gpt-4.1-mini",
    "TimeoutSeconds": 20,
    "MaxNewsItems": 12
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=localhost;Database=TradingMarket;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=True"
  },
  "Storage": {
    "SignalsPath": "data/signals.jsonl"
  },
  "Reporting": {
    "DefaultCapital": 1000,
    "EstimatedFeePercentPerSide": 0.1
  },
  "Notifications": {
    "ConsoleEnabled": true,
    "Email": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "UserName": "",
      "Password": "",
      "From": "",
      "To": ""
    },
    "Telegram": {
      "Enabled": false,
      "BotToken": "",
      "ChatId": ""
    }
  }
}
