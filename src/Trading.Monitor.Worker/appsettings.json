  "OpenAi": {
    "Enabled": true,
    "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
    "BaseUrl": "https://api.openai.com",
    "Model": "gpt-5.6-terra",
    "ReasoningEffort": "low",
    "TextVerbosity": "low",
    "TimeoutSeconds": 20,
    "MaxNewsItems": 12,
    "MinimumNewsItemsToAnalyze": 3,
    "MinimumMinutesBetweenCalls": 15,
    "MaxPromptCharacters": 6000,
    "OnlyAnalyzeWhenNewsChanged": true
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=localhost;Database=TradingMarket;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=True"
  },
  "Storage": {
    "SignalsPath": "data/signals.jsonl"
  },
  "Reporting": {
    "DefaultCapital": 1000,
    "EstimatedFeePercentPerSide": 0.1,
    "MinimumNetProfitPercentAfterCosts": 0.35
  },
  "ExchangeExecution": {
    "Enabled": true,
    "Provider": "BinanceSpot",
    "Mode": "Paper",
    "BaseUrl": "https://api.binance.com",
    "ApiKeyEnvironmentVariable": "BINANCE_API_KEY",
    "ApiSecretEnvironmentVariable": "BINANCE_API_SECRET",
    "AllowLiveOrders": false,
    "UseTestOrderEndpoint": true,
    "MaxCapitalPerTrade": 100,
    "DailyLossLimit": 50,
    "MinimumScoreToExecute": 95,
    "MinimumExpectedNetProfitPercentAfterCosts": 0.6,
    "EnableEntryOrders": true,
    "EnableExitOrders": true,
    "AllowShortSelling": false,
    "ReceiveWindowMilliseconds": 5000,
    "MaxSlippagePercent": 0.25,
    "AllowedSymbols": [ "BTCUSDT", "ETHUSDT", "SOLUSDT", "XRPUSDT", "ADAUSDT" ],
    "AllowAllSymbols": false,
    "KillSwitchEnabled": false,
    "MaxOpenPositions": 3,
    "MaxDailyNotional": 500,
    "LiveConfirmationEnvironmentVariable": "TRADING_MONITOR_LIVE_CONFIRM"
  },
  "TraderSignals": {
    "Enabled": true,
    "BinanceLeaderboardEnabled": true,
    "BinanceLeaderboardBaseUrl": "https://www.binance.com",
    "PeriodType": "WEEKLY",
    "TopTraderCount": 8,
    "SignalExpiryHours": 12,
    "TimeoutSeconds": 10
  },
  "Notifications": {
    "ConsoleEnabled": true,
    "Email": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "UserName": "",
      "PasswordEnvironmentVariable": "EMAIL_PASSWORD",
      "From": "",
      "To": ""
    },
    "Telegram": {
      "Enabled": false,
      "BotTokenEnvironmentVariable": "TELEGRAM_BOT_TOKEN",
      "ChatId": ""
    }
  }
