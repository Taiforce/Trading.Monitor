{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "TradingMonitor": {
    "Enabled": true,
    "Symbols": [ "BTCUSDT", "ETHUSDT", "SOLUSDT", "XRPUSDT", "ADAUSDT", "EURUSD", "GBPUSD", "USDJPY", "USDCHF", "AUDUSD", "USDCAD", "NZDUSD", "USDMXN", "EURMXN", "GBPJPY", "EURJPY", "EURGBP" ],
    "Intervals": [ "1s", "1m", "5m", "15m", "1h", "4h", "1d", "1w", "1M" ],
    "TriggerInterval": "5m",
    "CandleLimit": 250,
    "MinimumScore": 88,
    "EvaluationIntervalSeconds": 60,
    "DuplicateWindowMinutes": 20,
    "SignalExpiryMinutes": 8,
    "Horizons": [
      {
        "Name": "Rápida",
        "TriggerInterval": "5m",
        "SignalExpiryMinutes": 15,
        "MinimumScore": 88,
        "MinimumConfirmedIntervals": 3,
        "RequiredAlignedIntervals": [ "15m", "1h" ]
      },
      {
        "Name": "Intradía",
        "TriggerInterval": "15m",
        "SignalExpiryMinutes": 180,
        "MinimumScore": 90,
        "MinimumConfirmedIntervals": 3,
        "RequiredAlignedIntervals": [ "1h", "4h" ]
      },
      {
        "Name": "Swing",
        "TriggerInterval": "1h",
        "SignalExpiryMinutes": 2880,
        "MinimumScore": 92,
        "MinimumConfirmedIntervals": 4,
        "RequiredAlignedIntervals": [ "4h", "1d" ]
      },
      {
        "Name": "Semanal",
        "TriggerInterval": "1d",
        "SignalExpiryMinutes": 10080,
        "MinimumScore": 92,
        "MinimumConfirmedIntervals": 4,
        "RequiredAlignedIntervals": [ "1w" ]
      },
      {
        "Name": "Mensual",
        "TriggerInterval": "1w",
        "SignalExpiryMinutes": 43200,
        "MinimumScore": 94,
        "MinimumConfirmedIntervals": 4,
        "RequiredAlignedIntervals": [ "1M" ]
      }
    ],
    "RunOnce": false,
    "ExternalAiSignalsEnabled": true
  },
  "Risk": {
    "EntryAtrBuffer": 0.2,
    "AtrStopMultiplier": 1.5,
    "Target1R": 2.2,
    "Target2R": 3.4,
    "MinimumRiskReward": 2.2,
    "MinimumAtrPercent": 0.05,
    "MaximumAtrPercent": 8.0,
    "EstimatedFeePercentPerSide": 0.1,
    "EstimatedSpreadPercent": 0.05,
    "MinimumNetProfitPercentAfterCosts": 0.35,
    "ManagedProfitExitEnabled": true,
    "ManagedProfitExitPercentAfterCosts": 5.0,
    "ManagedQuickProfitExitPercentAfterCosts": 8.0,
    "ManagedTrailingGivebackPercent": 0.75,
    "ManagedProfitTrailCandlesAfterTarget": 1,
    "ManagedExitRequiresMomentumWeakness": false,
    "ManagedHardStopExitEnabled": false,
    "ManagedExpiryExitEnabled": false
  },
  "MarketSources": {
    "BinanceEnabled": true,
    "BinanceUsEnabled": true,
    "CoinbaseEnabled": true,
    "KrakenEnabled": true,
    "YahooFinanceForexEnabled": true,
    "AlphaVantageForexEnabled": true,
    "BinanceBaseUrl": "https://api.binance.com",
    "BinanceUsBaseUrl": "https://api.binance.us",
    "CoinbaseBaseUrl": "https://api.exchange.coinbase.com",
    "KrakenBaseUrl": "https://api.kraken.com",
    "YahooFinanceBaseUrl": "https://query1.finance.yahoo.com",
    "AlphaVantageBaseUrl": "https://www.alphavantage.co",
    "AlphaVantageApiKeyEnvironmentVariable": "ALPHA_VANTAGE_API_KEY",
    "TimeoutSeconds": 10
